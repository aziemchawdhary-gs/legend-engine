import meta::external::store::model::*;
import meta::external::store::relational::runtime::*;
import meta::pure::executionPlan::*;
import meta::pure::extension::*;
import meta::pure::graphFetch::*;
import meta::pure::graphFetch::executionPlan::*;
import meta::pure::graphFetch::routing::*;
import meta::pure::mapping::*;
import meta::pure::mapping::modelToModel::graphFetch::executionPlan::*;
import meta::pure::metamodel::type::*;
import meta::pure::metamodel::valuespecification::*;
import meta::relational::m2mSql::*;

// The plan rewrite that turns an M2M graph-fetch/serialize plan over a SqlModelConnection into a
// single SQL node. Registered through Extension.postProcessExecutionPlan, so it sees the fully
// assembled Pure plan before platform binding generates any Java for the nodes it removes.
//
// Every guard is a fallback, never a failure: a shape this slice cannot translate is left exactly as
// the M2M store contract built it and runs on the Java path as before.
function meta::relational::m2mSql::m2mSqlPlanPostProcessor(defaultConnection:meta::external::store::relational::runtime::DatabaseConnection[1]):Function<{ExecutionPlan[1], meta::pure::extension::Extension[*], DebugContext[1] -> ExecutionPlan[1]}>[1]
{
  {plan:ExecutionPlan[1], extensions:meta::pure::extension::Extension[*], debug:DebugContext[1] |
     ^$plan(rootExecutionNode = $plan.rootExecutionNode->meta::relational::m2mSql::collapseNode($defaultConnection, $extensions, $debug))
  }
}

function meta::relational::m2mSql::collapseNode(node:ExecutionNode[1], defaultConnection:meta::external::store::relational::runtime::DatabaseConnection[1], extensions:meta::pure::extension::Extension[*], debug:DebugContext[1]):ExecutionNode[1]
{
  $node->match(
  [
    // The only wrapper the plan funnel puts above the serialize node (function-parameter validation).
    s:SequenceExecutionNode[1]               | ^$s(executionNodes = $s.executionNodes->map(n | $n->collapseNode($defaultConnection, $extensions, $debug))),
    p:PureExpressionPlatformExecutionNode[1] | $p->collapseSerializeNode($defaultConnection, $extensions, $debug),
    n:ExecutionNode[1]                       | $n
  ]);
}

function <<access.private>> meta::relational::m2mSql::collapseSerializeNode(node:PureExpressionPlatformExecutionNode[1], defaultConnection:meta::external::store::relational::runtime::DatabaseConnection[1], extensions:meta::pure::extension::Extension[*], debug:DebugContext[1]):ExecutionNode[1]
{
  let reason = $node->m2mSqlCollapseRejection($extensions);
  if($reason->isNotEmpty(),
     | print(if($debug.debug, | 'M2M SQL fallback: ' + $reason->toOne() + '\n', | ''));
       $node;,
     {|
       let globalNode = $node.executionNodes->at(0)->cast(@StoreMappingGlobalGraphFetchExecutionNode);
       let routedTree = $globalNode.graphFetchTree.tree->cast(@RoutedRootGraphFetchTree<Any>);
       let setImpl    = $routedTree.sets->toOne()->cast(@meta::external::store::model::PureInstanceSetImplementation);
       let inMemory   = $globalNode.localGraphFetchExecutionNode->cast(@InMemoryRootGraphFetchExecutionNode);
       let connection = $inMemory.executionNodes->at(0)->cast(@StoreStreamReadingExecutionNode)
                                 .connection->cast(@SqlModelConnection);
       // Projected from the serialize tree, not the graph fetch tree: the router widens the latter with
       // whatever a root filter reads, and those properties are not part of the document.
       let query      = meta::relational::m2mSql::buildM2MSqlQuery($setImpl, $node->m2mSqlSerializeTree()->toOne()->cast(@RootGraphFetchTree<Any>), $inMemory->m2mSqlRootFilter($setImpl), $defaultConnection, $extensions, $debug);
       print(if($debug.debug, | 'M2M SQL collapse: ' + $query.sqlQuery + '\n', | ''));
       ^meta::relational::m2mSql::SQLGraphSerializeExecutionNode
       (
         resultType = ^ResultType(genericType = ^GenericType(rawType = String)),
         connection = $defaultConnection,
         setupSqls  = $query.setupSqls,
         sqlQuery   = $query.sqlQuery,
         url        = $connection.url
       );
     }
    );
}

// Returns why this node cannot be collapsed, or [] when it can. Written as a cascade rather than a
// list of conditions so that each guard only runs once the shape it assumes has been established.
function <<access.private>> meta::relational::m2mSql::m2mSqlCollapseRejection(node:PureExpressionPlatformExecutionNode[1], extensions:meta::pure::extension::Extension[*]):String[0..1]
{
  if(!$node.expression->instanceOf(SimpleFunctionExpression) || !$node.expression->cast(@SimpleFunctionExpression).func->in(meta::relational::m2mSql::m2mSqlSerializeFunctions()),
     | 'not a graph fetch serialize node',
     | if(!$node->m2mSqlSerializeExpressionIsCurtailed(),
          | 'serialize expression carries more than the curtailed graph fetch collection',
          | if($node.executionNodes->size() != 1 || !$node.executionNodes->at(0)->instanceOf(StoreMappingGlobalGraphFetchExecutionNode),
               | 'serialize node does not wrap exactly one store-mapping graph fetch node',
               | $node.executionNodes->at(0)->cast(@StoreMappingGlobalGraphFetchExecutionNode)->m2mSqlGlobalNodeRejection($node->m2mSqlSerializeTree(), $extensions)
              )
         )
    );
}

// The collapse replaces the whole platform node, so anything the residual serialize expression still
// carries beyond `serialize(<curtailed collection>, tree)` would be silently dropped. Only the child
// node is inspected on the success path, so this pins the expression itself: exactly two parameters,
// and the collection parameter must be the empty placeholder that
// meta::pure::platform::executionPlan::generation::serializeFunctionProcessor substitutes for the
// sub-expression it moved into the child node — never a function application left in place.
function <<access.private>> meta::relational::m2mSql::m2mSqlSerializeExpressionIsCurtailed(node:PureExpressionPlatformExecutionNode[1]):Boolean[1]
{
  let parameters = $node.expression->cast(@SimpleFunctionExpression).parametersValues->evaluateAndDeactivate();
  ($parameters->size() == 2)
    && !$parameters->at(0)->instanceOf(SimpleFunctionExpression)
    && $parameters->at(0)->instanceOf(InstanceValue)
    && $parameters->at(0)->cast(@InstanceValue).values->isEmpty();
}

function <<access.private>> meta::relational::m2mSql::m2mSqlGlobalNodeRejection(globalNode:StoreMappingGlobalGraphFetchExecutionNode[1], serializeTree:GraphFetchTree[0..1], extensions:meta::pure::extension::Extension[*]):String[0..1]
{
  if($serializeTree->isEmpty(),
     | 'serialize target tree is not a plain graph fetch tree',
     | if($globalNode.children->isNotEmpty() || $globalNode.xStorePropertyMapping->isNotEmpty(),
          | 'cross-store graph fetch not yet translated',
          | if(!$globalNode.graphFetchTree.tree->instanceOf(RoutedRootGraphFetchTree),
               | 'graph fetch tree is not a routed root tree',
               {|
                 let routedTree = $globalNode.graphFetchTree.tree->cast(@RoutedRootGraphFetchTree<Any>);
                 if($routedTree.sets->size() != 1 || !$routedTree.sets->toOne()->instanceOf(meta::external::store::model::PureInstanceSetImplementation),
                    | 'root class mapping is not a single Pure instance set implementation',
                    | if(!meta::relational::m2mSql::sameTreeShape($serializeTree->toOne(), $routedTree->cast(@GraphFetchTree), true),
                         | 'serialize tree differs from the graph fetch tree',
                         // The global node carries the same enableConstraints flag the reader is built with;
                         // an absent one is treated as checked.
                         | if(meta::relational::m2mSql::classAndSupertypeConstraintsExist(meta::relational::m2mSql::treeClasses($routedTree->cast(@GraphFetchTree))) && $globalNode.enableConstraints->orElse(true),
                              | 'constraints on the target classes are not yet translated',
                              | $globalNode.localGraphFetchExecutionNode->m2mSqlLocalNodeRejection($routedTree, $serializeTree->toOne()->cast(@RootGraphFetchTree<Any>), $extensions)
                             )
                        )
                   );
               }
              )
         )
    );
}

function <<access.private>> meta::relational::m2mSql::m2mSqlLocalNodeRejection(localNode:LocalGraphFetchExecutionNode[1], routedTree:RoutedRootGraphFetchTree<Any>[1], serializeTree:RootGraphFetchTree<Any>[1], extensions:meta::pure::extension::Extension[*]):String[0..1]
{
  if(!$localNode->instanceOf(InMemoryRootGraphFetchExecutionNode) || $localNode->instanceOf(InMemoryCrossStoreGraphFetchExecutionNode),
     | 'local graph fetch node is not a plain in-memory root node',
     {|
       let inMemory = $localNode->cast(@InMemoryRootGraphFetchExecutionNode);
       if($inMemory.checked,
          | 'checked graph fetch not yet translated',
          | if($inMemory.executionNodes->size() != 1 || !$inMemory.executionNodes->at(0)->instanceOf(StoreStreamReadingExecutionNode),
               | 'in-memory node does not read from a single store stream',
               {|
                 let reader = $inMemory.executionNodes->at(0)->cast(@StoreStreamReadingExecutionNode);
                 if(!$reader.connection->instanceOf(SqlModelConnection),
                    | 'source connection is not a SqlModelConnection',
                    | if($reader.checked,
                         | 'checked graph fetch not yet translated',
                         {|
                           let setImpl = $routedTree.sets->toOne()->cast(@meta::external::store::model::PureInstanceSetImplementation);
                           let verdict = meta::relational::m2mSql::canPlanM2MSql($setImpl, $routedTree->cast(@RootGraphFetchTree<Any>), $setImpl.parent);
                           if(!$verdict.translatable,
                              | $verdict.reason,
                              | if($inMemory.filter->isNotEmpty() && $inMemory->m2mSqlRootFilter($setImpl)->isEmpty(),
                                   | 'root filter is not translatable to the source',
                                   {|
                                     let narrowing = $setImpl->m2mSqlSerializeTreeRejection($serializeTree, $routedTree->cast(@GraphFetchTree));
                                     if($narrowing->isNotEmpty(),
                                        | $narrowing,
                                        {|
                                          let sourceShape = $setImpl->meta::relational::m2mSql::m2mSqlSourceTree($serializeTree, $inMemory->m2mSqlRootFilter($setImpl), $extensions)->cast(@GraphFetchTree)->m2mSqlSourceTreeRejection();
                                          if($sourceShape->isNotEmpty(),
                                             | $sourceShape,
                                             | $setImpl->m2mSqlSourceConstraintRejection($routedTree->cast(@RootGraphFetchTree<Any>), $reader.enableConstraints, $extensions)
                                            );
                                        }
                                       );
                                   }
                                  )
                             );
                         }
                        )
                   );
               }
              )
         );
     }
    );
}

// The document is projected from the serialize tree, which may select less at the root than the graph
// fetch tree does (see sameTreeShape). That is only the same document when what it leaves out has no
// effect beyond its own value: an explode mapping multiplies the instances whether or not its property
// is serialized, and an enumeration mapping fails the whole query on a value it has no entry for. The
// first is caught by gating the serialize tree itself (an explode mapping it does not select is a
// rejection there); the second is checked here.
function <<access.private>> meta::relational::m2mSql::m2mSqlSerializeTreeRejection(setImpl:meta::external::store::model::PureInstanceSetImplementation[1], serializeTree:RootGraphFetchTree<Any>[1], routedTree:GraphFetchTree[1]):String[0..1]
{
  let verdict = meta::relational::m2mSql::canPlanM2MSql($setImpl, $serializeTree, $setImpl.parent);
  let omitted = $routedTree.propertyTrees()->filter(y | !$serializeTree.propertyTrees()->exists(x | $x.property.name == $y.property.name));
  if(!$verdict.translatable,
     | $verdict.reason,
     | if($omitted->exists(y | $setImpl->meta::relational::m2mSql::purePropertyMappingsFor($y.property.name->toOne()).transformer->isNotEmpty()),
          | 'graph fetch tree fetches an enumeration-mapped property the serialize tree omits',
          | []
         )
    );
}

// The inner query reads the source document through the synthetic store, which can only extract the
// property types it has an extract type for, by names that are plain identifiers (the JSON path is
// built from them). Anything else is a fallback here rather than a failure during synthesis.
function <<access.private>> meta::relational::m2mSql::m2mSqlSourceTreeRejection(sourceTree:GraphFetchTree[1]):String[0..1]
{
  $sourceTree.propertyTrees()->map(pt |
    let name = $pt.property.name->toOne();
    let type = $pt.property->functionReturnType().rawType->toOne();
    if(!$name->matches('[A-Za-z_][A-Za-z0-9_]*'),
       | 'source property name is not a plain identifier: ' + $name,
       | if($type->instanceOf(DataType),
            | if($type->meta::relational::m2mSql::isExtractableSourceType(), | [], | 'source property type not yet translated: ' + $name),
            | $pt->cast(@GraphFetchTree)->m2mSqlSourceTreeRejection()
           )
      );
  )->first();
}

// The query's root `filter()` re-expressed over the source, or [] when there is none or it is not
// translatable. The guard and the builder each call this rather than the guard handing its result
// on, which keeps every guard in the cascade a plain reason string.
function <<access.private>> meta::relational::m2mSql::m2mSqlRootFilter(inMemory:InMemoryRootGraphFetchExecutionNode[1], setImpl:meta::external::store::model::PureInstanceSetImplementation[1]):ValueSpecification[0..1]
{
  if($inMemory.filter->isEmpty(),
     | [],
     | meta::relational::m2mSql::rewriteTargetFilterToSource($inMemory.filter->toOne(), $setImpl, meta::relational::m2mSql::m2mSqlSourceVariable($setImpl.srcClass->toOne()->cast(@Class<Any>))));
}

// The serialize call's own target tree, or [] when the second argument is not a plain tree literal.
function <<access.private>> meta::relational::m2mSql::m2mSqlSerializeTree(node:PureExpressionPlatformExecutionNode[1]):GraphFetchTree[0..1]
{
  let parameters = $node.expression->cast(@SimpleFunctionExpression).parametersValues->evaluateAndDeactivate();
  if($parameters->size() < 2 || !$parameters->at(1)->instanceOf(InstanceValue),
     | [],
     {|
       let values = $parameters->at(1)->cast(@InstanceValue).values;
       if($values->size() != 1 || !$values->toOne()->instanceOf(RootGraphFetchTree),
          | [],
          | $values->toOne()->cast(@GraphFetchTree)
         );
     }
    );
}

// Structural equality of two graph fetch trees by class and property path. The serialize tree is a
// plain tree and the graph fetch tree a routed one, so their printed forms differ and cannot be
// compared directly.
//
// `allowExtraLeaves` lets `b` (the graph fetch tree) carry primitive leaves at this level that `a` (the
// serialize tree) does not: the router adds the properties a root `filter()` reads to the fetch tree,
// and moves the ones it reads to the end. So properties are matched by name rather than by position;
// the document's order is the serialize tree's, which is what it is projected from. Whether leaving a
// fetched leaf out of the document is safe is m2mSqlSerializeTreeRejection's to decide. It is only
// ever passed for the root level, which is the only level a root filter is rewritten for.
function <<access.private>> meta::relational::m2mSql::sameTreeShape(a:GraphFetchTree[1], b:GraphFetchTree[1], allowExtraLeaves:Boolean[1]):Boolean[1]
{
  let aProperties = $a.propertyTrees();
  let bProperties = $b.propertyTrees()->filter(y | !$allowExtraLeaves || $y.subTrees->isNotEmpty() || $aProperties->exists(x | ($x.property.name == $y.property.name) && ($x.alias == $y.alias)));
  ($a.subTypeTrees->isEmpty() && $b.subTypeTrees->isEmpty())
    && ($a->m2mSqlTreeClass() == $b->m2mSqlTreeClass())
    && ($aProperties->size() == $bProperties->size())
    && $aProperties->forAll(x |
         $bProperties->filter(y | ($x.property.name == $y.property.name) && ($x.alias == $y.alias))->match(
         [
           y:PropertyGraphFetchTree[1] | sameTreeShape($x->cast(@GraphFetchTree), $y->cast(@GraphFetchTree), false),
           y:PropertyGraphFetchTree[*] | false
         ]);
       );
}

function <<access.private>> meta::relational::m2mSql::m2mSqlTreeClass(tree:GraphFetchTree[1]):Type[0..1]
{
  $tree->match(
  [
    r:RootGraphFetchTree<Any>[1]  | $r.class,
    p:PropertyGraphFetchTree[1]   | $p.property.genericType.rawType,
    g:GraphFetchTree[1]           | []
  ]);
}

// The mirror image of the target-class constraint guard above. On the Java path the source document is
// deserialized into real instances of the source classes before any transform runs, and the store
// stream reader enforces those classes' constraints while it does so -- but only when the reader was
// built with enableConstraints, the same flag the target-class guard keys off, so a plan generated with
// constraints disabled has nothing to lose by collapsing. The SQL path never materializes a source
// object, so a source-class constraint would otherwise simply stop being checked -- a silent behaviour
// change rather than a fallback. The source classes are exactly the classes of the calculated source
// tree, which is the same tree buildM2MSqlQuery synthesizes the source store from, so it is computed
// here the same way. Deliberately run only after canPlanM2MSql has accepted the shape: on anything it
// rejects, calculateSourceTree is never reached on the collapse path either.
function <<access.private>> meta::relational::m2mSql::m2mSqlSourceConstraintRejection(setImpl:meta::external::store::model::PureInstanceSetImplementation[1], targetTree:RootGraphFetchTree<Any>[1], enableConstraints:Boolean[1], extensions:meta::pure::extension::Extension[*]):String[0..1]
{
  let sourceTree = $targetTree->meta::pure::graphFetch::calculateSourceTree($setImpl.parent, $extensions);
  if($enableConstraints && meta::relational::m2mSql::classAndSupertypeConstraintsExist($sourceTree->cast(@GraphFetchTree)->treeClasses()),
     | 'constraints on the source classes are not yet translated',
     | []
    );
}

function <<access.private>> meta::relational::m2mSql::treeClasses(tree:GraphFetchTree[1]):Class<Any>[*]
{
  $tree->m2mSqlTreeClass()->filter(t | $t->instanceOf(Class))->cast(@Class<Any>)
       ->concatenate($tree.propertyTrees()->map(pt | $pt->cast(@GraphFetchTree)->treeClasses()));
}

// A class's own constraints are visible via $c.constraints, but a constraint declared on a superclass
// is not -- getAllTypeGeneralisations (which includes the class itself) closes that gap for both the
// target- and source-class constraint guards above.
function <<access.private>> meta::relational::m2mSql::classAndSupertypeConstraintsExist(classes:Class<Any>[*]):Boolean[1]
{
  $classes->exists(c | $c->meta::pure::functions::meta::getAllTypeGeneralisations()->filter(t | $t->instanceOf(Class))->cast(@Class<Any>).constraints->isNotEmpty());
}

// Only the plain `serialize(collection, tree)` overload is translated in this slice: the checked and
// AlloySerializationConfig overloads change the emitted document in ways the SQL projection does not
// reproduce.
function <<access.private>> meta::relational::m2mSql::m2mSqlSerializeFunctions():Function<Any>[*]
{
  [
    meta::pure::graphFetch::execution::serialize_T_MANY__RootGraphFetchTree_1__String_1_
  ];
}
