import meta::relational::m2mSql::*;
import meta::external::store::model::*;
import meta::pure::mapping::*;
import meta::pure::mapping::modelToModel::contract::*;
import meta::pure::graphFetch::*;
import meta::pure::metamodel::type::*;
import meta::pure::metamodel::valuespecification::*;
import meta::pure::metamodel::function::property::*;

// Conservative whitelist deciding whether a given M2M mapping + target graph fetch tree is
// SQL-translatable. This is the gate the plan-rewrite collapse (Extension.postProcessExecutionPlan)
// consults before rewriting a Java M2M execution plan into a SQL one: a construct is only ever
// treated as translatable when it is positively known to be so. Anything not recognized falls back
// to the existing Java execution path, so being wrong in the conservative direction is always safe.
Class meta::relational::m2mSql::M2MSqlTranslatability
{
  translatable : Boolean[1];
  reason       : String[0..1];
}

function meta::relational::m2mSql::canPlanM2MSql(setImpl:PureInstanceSetImplementation[1], targetTree:RootGraphFetchTree<Any>[1], mapping:Mapping[1]):meta::relational::m2mSql::M2MSqlTranslatability[1]
{
  let reasons = meta::relational::m2mSql::untranslatableReasons($setImpl, $targetTree->cast(@GraphFetchTree), $mapping, true);
  ^meta::relational::m2mSql::M2MSqlTranslatability
  (
    translatable = $reasons->isEmpty(),
    reason       = if($reasons->isEmpty(), | [], | $reasons->at(0))
  );
}

// Checks that apply to a PureInstanceSetImplementation itself, regardless of which of its
// properties the target tree actually selects: a non-local-property set implementation, whose
// filter (if any) is translatable, is a prerequisite for translating anything reachable through it.
// `isRoot` is true only for the set implementation at the root of the target tree.
function meta::relational::m2mSql::rootLevelReasons(setImpl:PureInstanceSetImplementation[1], isRoot:Boolean[1]):String[*]
{
  let filterReasons = if($setImpl.filter->isEmpty(),
     | [],
     // A nested set's ~filter semantics on the Java graph fetch path have not been verified against
     // the SQL projection, so only the root set's filter is pushed down.
     | if(!$isRoot,
          | ['mapping filter not yet translated'],
          {|
            let srcClass = $setImpl.srcClass->toOne()->cast(@Class<Any>);
            let reason   = $setImpl->meta::relational::m2mSql::mappingFilterOver(meta::relational::m2mSql::m2mSqlSourceVariable($srcClass))->toOne()->meta::relational::m2mSql::explainUntranslatableFilterExpression();
            if($reason->isEmpty(), | [], | ('unsupported mapping filter: ' + $reason->toOne()));
          }
         )
    );
  if($filterReasons->isNotEmpty(),
     | $filterReasons,
     | if($setImpl.mappingClass->isNotEmpty() || $setImpl.propertyMappings->exists(pm | $pm.localMappingProperty == true),
          | ['local mapping property not yet translated'],
          | []
         )
    );
}

function meta::relational::m2mSql::untranslatableReasons(setImpl:PureInstanceSetImplementation[1], tree:GraphFetchTree[1], mapping:Mapping[1], isRoot:Boolean[1]):String[*]
{
  let rootReasons = $setImpl->rootLevelReasons($isRoot)->concatenate($setImpl->meta::relational::m2mSql::explodeShapeReasons($tree, $isRoot));
  if($rootReasons->isNotEmpty(),
     | $rootReasons->at(0),
     | if($tree.subTypeTrees->isNotEmpty(),
          | ['subType graph fetch trees not yet translated'],
          | $tree.propertyTrees()->map(pt | meta::relational::m2mSql::untranslatablePropertyReasons($setImpl, $pt, $mapping, $isRoot))
         )
    );
}

// Rejections that depend only on the shape of the property tree node, before any property mapping is
// resolved.
function meta::relational::m2mSql::propertyShapeReasons(propertyTree:PropertyGraphFetchTree[1]):String[*]
{
  if($propertyTree.subType->isNotEmpty(),
     | ['subType graph fetch trees not yet translated'],
     // Inner-query column names are derived from aliases, and the SQL generator drops an embedded `"`
     // from an identifier, so `a"b` and `ab` would land on the same column.
     | if($propertyTree.alias->isNotEmpty() && $propertyTree.alias->toOne()->contains('"'),
          | [('alias containing a double quote not yet translated: ' + $propertyTree.alias->toOne())],
     // A to-many complex property needs one JSON object per source element; the flat single-row
     // projection in jsonProjection.pure cannot express that and asserts rather than falling back,
     // so it has to be rejected here instead.
     | if($propertyTree.subTrees->isNotEmpty() && !$propertyTree.property.multiplicity->meta::pure::functions::meta::hasToOneUpperBound(),
          | ['to-many complex property not yet translated'],
          // A primitive leaf is serialized from its SQL value; only the types the parity corpus proves
          // serialize as the Java path does (see isExtractableSourceType) are let through. This also
          // covers a Float computed from Integers (`divide`).
          | if($propertyTree.subTrees->isEmpty() && $propertyTree.property.genericType.rawType->toOne()->instanceOf(PrimitiveType) && !$propertyTree.property.genericType.rawType->toOne()->in(meta::relational::m2mSql::provenPrimitiveTypes()),
               | [('property type not yet translated: ' + $propertyTree.property.name->toOne())],
          // A primitive collection is extracted as the text of its JSON array and re-parsed in the outer
          // document. That extract is typed by the element, and only the VARCHAR one takes an array:
          // `cast(json_extract(...) as INTEGER)` of `[1,2,3]` fails at execution, not at planning.
          | if($propertyTree.subTrees->isEmpty() && !$propertyTree.property.multiplicity->meta::pure::functions::meta::hasToOneUpperBound() && ($propertyTree.property.genericType.rawType != String),
               | [('non-string primitive collection not yet translated: ' + $propertyTree.property.name->toOne())],
               | []
              )
             )
         )
        )
    );
}

// `isRoot` is true when `setImpl` is the set implementation at the root of the target tree.
function meta::relational::m2mSql::untranslatablePropertyReasons(setImpl:PureInstanceSetImplementation[1], propertyTree:PropertyGraphFetchTree[1], mapping:Mapping[1], isRoot:Boolean[1]):String[*]
{
  let shapeReasons = meta::relational::m2mSql::propertyShapeReasons($propertyTree);
  if($shapeReasons->isNotEmpty(),
     | $shapeReasons,
     {|
       let propertyMappings = $setImpl->propertyMappingsByPropertyName($propertyTree.property.name->toOne())
                                       ->filter(pm | $pm->instanceOf(PurePropertyMapping))
                                       ->cast(@PurePropertyMapping);
       let transformerReasons = meta::relational::m2mSql::enumTransformerReasons($propertyMappings, $propertyTree, $isRoot);
       if($propertyMappings->isEmpty(),
          // The Java path only passes a property through unmapped when it is data-typed; a complex
          // property with no property mapping is left empty there, whatever the source class has under
          // the same name, so there is nothing for the projection to build.
          | if($propertyTree.subTrees->isNotEmpty(),
               | [('unmapped complex property not yet translated: ' + $propertyTree.property.name->toOne())],
               | if(!$propertyTree.property->isPropertyAutoMapped($setImpl),
                    | [('property ' + $propertyTree.property.name->toOne() + ' does not resolve to a translatable mapping')],
                    // An enumeration-typed property is fine here: the synthetic source store extracts it as
                    // VARCHAR, which is the enum's name on both sides.
                    | meta::relational::m2mSql::autoMappedLeafReasons($setImpl, $propertyTree)
                   )
              ),
          | if($transformerReasons->isNotEmpty(),
               | $transformerReasons,
               | if($propertyMappings->exists(pm | $pm.explodeProperty == true) && !$propertyMappings->at(0).transform.expressionSequence->toOne()->meta::relational::m2mSql::isExplodableSourceCollection(),
                    | ['explode property mapping is not a single source navigation to a String or Integer collection'],
                    {|
                      let transformReasons = $propertyMappings->map(pm | $pm.transform.expressionSequence->toOne()->meta::relational::m2mSql::explainUntranslatableExpression());
                      if($transformReasons->isNotEmpty(),
                         | $transformReasons->map(r | 'unsupported transform for property ' + $propertyTree.property.name->toOne() + ': ' + $r),
                         | if($propertyTree.subTrees->isEmpty(),
                              | meta::relational::m2mSql::mappedLeafReasons($propertyMappings->at(0), $propertyTree, $isRoot),
                              {|
                                // A complex property's transform has to be a plain chain of source property
                                // accesses, because the SQL projection derives the subtree's presence check
                                // from it as a JSON path (jsonProjection.pure's sourceJsonPath). The
                                // whitelist admits `toOne` etc., which pass every other check but have no
                                // JSON path, so this has to be rejected here rather than blowing up in the
                                // projection.
                                if(!$propertyMappings->forAll(pm | $pm.transform.expressionSequence->toOne()->meta::relational::m2mSql::isPlainSourceNavigation()),
                                   | [('complex property ' + $propertyTree.property.name->toOne() + ' is not a plain source navigation')],
                                   // A bare `$src` is a plain navigation with an empty path: the source object
                                   // the subtree is built from is the root document itself. sourceJsonPath then
                                   // yields no segments at all, and the presence column would read an empty JSON
                                   // path. Nothing above catches this, so it is rejected here.
                                   | if(!$propertyMappings->forAll(pm | $pm.transform.expressionSequence->toOne()->instanceOf(SimpleFunctionExpression)),
                                        | [('complex property ' + $propertyTree.property.name->toOne() + ' maps the source object itself, with no source property access to navigate through')],
                                        {|
                                          let nestedSetImpl = meta::relational::m2mSql::resolveNestedSetImplementation($propertyMappings->at(0), $mapping);
                                          if($nestedSetImpl->isEmpty(),
                                             | [('nested mapping for property ' + $propertyTree.property.name->toOne() + ' could not be resolved')],
                                             | meta::relational::m2mSql::untranslatableReasons($nestedSetImpl->toOne(), $propertyTree->cast(@GraphFetchTree), $mapping, false)
                                            );
                                        }
                                       )
                                  );
                              }
                             )
                        );
                    }
                   )
              )
         );
     }
    );
}

// What a mapped primitive leaf's transform has to look like beyond being whitelisted, because the inner
// query extracts each source property by that property's own shape:
// - below the root a leaf is read as JSON (`data->'a'->'b'`), which only a plain navigation leaves intact;
// - a collection leaf is the text of a JSON array, which only a to-many String source property yields;
// - a to-one leaf must not read a source collection at all (`$src.names->toOne()` renders as the array).
// An exploded leaf is exempt: isExplodableSourceCollection has already pinned its shape.
function <<access.private>> meta::relational::m2mSql::mappedLeafReasons(propertyMapping:PurePropertyMapping[1], propertyTree:PropertyGraphFetchTree[1], isRoot:Boolean[1]):String[*]
{
  let transform = $propertyMapping.transform.expressionSequence->toOne();
  let name      = $propertyTree.property.name->toOne();
  if($propertyMapping.explodeProperty == true,
     | [],
     | if(!$isRoot && !$transform->meta::relational::m2mSql::isPlainSourceNavigation(),
          | [('computed property ' + $name + ' on a nested class mapping not yet translated')],
          | if(!$propertyTree.property.multiplicity->meta::pure::functions::meta::hasToOneUpperBound(),
               | if($transform->meta::relational::m2mSql::isPlainSourceNavigation() && !$transform.multiplicity->meta::pure::functions::meta::hasToOneUpperBound() && ($transform.genericType.rawType == String),
                    | [],
                    | [('collection property ' + $name + ' is not mapped from a to-many String source property')]
                   ),
               | if($transform->meta::relational::m2mSql::readsSourceCollection(),
                    | [('property ' + $name + ' reads a source collection')],
                    | []
                   )
              )
         )
    );
}

function <<access.private>> meta::relational::m2mSql::autoMappedLeafReasons(setImpl:PureInstanceSetImplementation[1], propertyTree:PropertyGraphFetchTree[1]):String[*]
{
  let srcProperty = $setImpl.srcClass->toOne()->cast(@Class<Any>)->propertyByName($propertyTree.property.name->toOne());
  if(!$propertyTree.property.multiplicity->meta::pure::functions::meta::hasToOneUpperBound() && ($srcProperty->isEmpty() || $srcProperty->toOne().multiplicity->meta::pure::functions::meta::hasToOneUpperBound()),
     | [('collection property ' + $propertyTree.property.name->toOne() + ' is not mapped from a to-many String source property')],
     | []
    );
}

function <<access.private>> meta::relational::m2mSql::readsSourceCollection(vs:ValueSpecification[1]):Boolean[1]
{
  $vs->meta::relational::m2mSql::anySubExpression(e | $e->instanceOf(SimpleFunctionExpression) && $e->cast(@SimpleFunctionExpression).func->instanceOf(Property) && !$e.multiplicity->meta::pure::functions::meta::hasToOneUpperBound());
}

// Whether the expression, or anything under it, satisfies `test`. A function taking a collection
// (`plus`, `times`) holds its operands as the values of one InstanceValue, so those are walked too.
function <<access.private>> meta::relational::m2mSql::anySubExpression(vs:ValueSpecification[1], test:Function<{ValueSpecification[1]->Boolean[1]}>[1]):Boolean[1]
{
  $test->eval($vs) || $vs->match(
  [
    sfe:SimpleFunctionExpression[1] | $sfe.parametersValues->evaluateAndDeactivate()->exists(p | $p->meta::relational::m2mSql::anySubExpression($test)),
    i:InstanceValue[1]              | $i.values->filter(v | $v->instanceOf(ValueSpecification))->cast(@ValueSpecification)->exists(v | $v->meta::relational::m2mSql::anySubExpression($test)),
    v:ValueSpecification[1]         | false
  ]);
}

// An explode mapping turns one source row into one target instance per element of a source collection.
// The SQL projection does that with a single `unnest` in the inner SELECT, which multiplies whole rows:
// so it can only be the root set implementation's (a nested one would have to multiply a subtree under
// one parent document), there can only be one (DuckDB zips several unnests, and what the Java path does
// with several is not established), and the tree has to select it as a leaf -- an explode mapping the
// tree leaves out still multiplies the instances on the Java path, which the projection would not know
// to do.
function <<access.private>> meta::relational::m2mSql::explodeShapeReasons(setImpl:PureInstanceSetImplementation[1], tree:GraphFetchTree[1], isRoot:Boolean[1]):String[*]
{
  let exploded = $setImpl.propertyMappings->filter(pm | $pm->instanceOf(PurePropertyMapping))->cast(@PurePropertyMapping)->filter(pm | $pm.explodeProperty == true);
  if($exploded->isEmpty(),
     | [],
     | if(!$isRoot,
          | ['explode property mapping on a nested class mapping not yet translated'],
          | if($exploded->size() != 1,
               | ['more than one explode property mapping not yet translated'],
               | if(!$tree.propertyTrees()->exists(pt | ($pt.property.name == $exploded->toOne().property.name) && $pt.subTrees->isEmpty()),
                    | ['explode property mapping is not selected as a leaf of the graph fetch tree'],
                    | []
                   )
              )
         )
    );
}

// `$src.<property>` and nothing more, where the property is a to-many String or Integer: the one shape
// the `unnest` of a JSON array extract is built from, and the two element types the parity corpus
// proves (FLOAT[] and DECIMAL[] are narrower in DuckDB than their scalar extracts, for one).
function <<access.private>> meta::relational::m2mSql::isExplodableSourceCollection(vs:ValueSpecification[1]):Boolean[1]
{
  $vs->match(
  [
    sfe:SimpleFunctionExpression[1] |
      $sfe.func->instanceOf(Property)
        && ($sfe.parametersValues->evaluateAndDeactivate()->size() == 1)
        && $sfe.parametersValues->evaluateAndDeactivate()->toOne()->instanceOf(VariableExpression)
        && !$sfe.multiplicity->meta::pure::functions::meta::hasToOneUpperBound()
        && $sfe.genericType.rawType->in([String, Integer]),
    v:ValueSpecification[1] | false
  ]);
}

// An enumeration transformer is translated as a CASE over the transform's result in the outer document
// (see jsonProjection.pure's m2mSqlEnumCaseReference), which needs that result to be one SQL scalar:
// a to-one property of the root set implementation. A nested leaf reaches the outer query as JSON
// rather than as a scalar, and a to-many one as the text of a JSON array. The source values have to be
// of the transform's own type -- values of its enumeration (compared by name), strings or integers --
// because that is how the Java path looks them up: a value of another type never matches there, where
// a comparison by name or text would.
function <<access.private>> meta::relational::m2mSql::enumTransformerReasons(propertyMappings:PurePropertyMapping[*], propertyTree:PropertyGraphFetchTree[1], isRoot:Boolean[1]):String[*]
{
  let transformers = $propertyMappings.transformer;
  if($transformers->isEmpty(),
     | [],
     | if(!$isRoot || ($propertyMappings->size() != 1) || $propertyMappings->exists(pm | $pm.explodeProperty == true) || !$propertyTree.property.multiplicity->meta::pure::functions::meta::hasToOneUpperBound() || !$transformers->toOne()->instanceOf(EnumerationMapping),
          | ['enumeration transformer not yet translated'],
          {|
            let sourceValues  = $transformers->toOne()->cast(@EnumerationMapping<Any>).enumValueMappings.sourceValues;
            let transformType = $propertyMappings->toOne().transform.expressionSequence->toOne().genericType.rawType;
            if($sourceValues->forAll(v | $v->instanceOf(Enum) && ($v->type() == $transformType))
                 || (($transformType == String) && $sourceValues->forAll(v | $v->instanceOf(String)))
                 || (($transformType == Integer) && $sourceValues->forAll(v | $v->instanceOf(Integer))),
               | [],
               | ['enumeration transformer source values do not match the type of the transform']
              );
          }
         )
    );
}

// Resolves the set implementation a complex (non-primitive) property mapping's target belongs to,
// following the same two paths the M2M router itself uses: an explicit targetSetImplementationId,
// or (when unset) the root class mapping for the property's declared type elsewhere in the mapping.
function meta::relational::m2mSql::resolveNestedSetImplementation(pm:PurePropertyMapping[1], mapping:Mapping[1]):PureInstanceSetImplementation[0..1]
{
  let targetSetImpl = if($pm.targetSetImplementationId == '',
     | let targetClass = $pm.property.genericType.rawType->toOne()->cast(@Class<Any>);
       $mapping->rootClassMappingByClass($targetClass);,
     | $mapping->classMappingById($pm.targetSetImplementationId);
    );
  if($targetSetImpl->isEmpty() || !$targetSetImpl->toOne()->instanceOf(PureInstanceSetImplementation),
     | [],
     | $targetSetImpl->toOne()->cast(@PureInstanceSetImplementation)
    );
}

// Property transform lambdas are only translatable when every expression in them is one of:
// the $src parameter itself, a primitive literal, a property access chained on a translatable
// operand, or a call to a whitelisted arithmetic/string function on translatable operands.
// Returns the reason the expression is NOT translatable, or [] when it is.
function meta::relational::m2mSql::explainUntranslatableExpression(vs:ValueSpecification[1]):String[0..1]
{
  $vs->meta::relational::m2mSql::explainUntranslatable(meta::relational::m2mSql::sqlTranslatableFunctionWhitelist());
}

// The same for a filter -- a mapping's ~filter or a rewritten root filter() -- which may also compare
// and combine conditions. Those functions are kept out of property transforms: as a projected value,
// a comparison against an absent operand is `false` on the Java path and NULL in SQL.
function meta::relational::m2mSql::explainUntranslatableFilterExpression(vs:ValueSpecification[1]):String[0..1]
{
  $vs->meta::relational::m2mSql::explainUntranslatable(meta::relational::m2mSql::sqlTranslatableFunctionWhitelist()->concatenate(meta::relational::m2mSql::sqlTranslatableFilterFunctions()));
}

function <<access.private>> meta::relational::m2mSql::explainUntranslatable(vs:ValueSpecification[1], whitelist:Function<Any>[*]):String[0..1]
{
  $vs->match(
  [
    v:VariableExpression[1] |
      if($v.name == 'src', | [], | 'unsupported variable in transform: $' + $v.name),
    i:InstanceValue[1] |
      // Primitive literals only. An enumeration literal is a DataType too, but comparing one against
      // the VARCHAR an enumeration-typed source property is extracted as is not established. A function
      // taking a collection (`plus`, `times`) holds its operands as the values of one InstanceValue, so
      // those are checked like any other operand.
      if($i.genericType->isNotEmpty() && $i.genericType.rawType->isNotEmpty() && $i.genericType.rawType->toOne()->instanceOf(PrimitiveType),
         | $i.values->filter(v | $v->instanceOf(ValueSpecification))->cast(@ValueSpecification)->map(v | $v->meta::relational::m2mSql::explainUntranslatable($whitelist))->first(),
         | 'unsupported literal in transform'
        ),
    sfe:SimpleFunctionExpression[1] |
      // An enumeration-typed source property needs no special casing: the synthetic source store
      // extracts it as VARCHAR. An enumeration *transformer* is a different thing, handled by the caller.
      let params = $sfe.parametersValues->evaluateAndDeactivate();
      if(!($sfe.func->instanceOf(Property) || $sfe.func->in($whitelist)),
         | 'unsupported function in transform: ' + $sfe.functionName->orElse($sfe.func->elementToPath()),
         // pureToSQLQuery asserts on an equality with a to-many side rather than translating it.
         | if(($sfe.func == equal_Any_MANY__Any_MANY__Boolean_1_) && $params->exists(p | !$p.multiplicity->meta::pure::functions::meta::hasToOneUpperBound()),
              | 'equality over a collection is not translated',
              // `!(a == b)` alone is rendered null-safely. Under anything else the equality is a plain
              // `=`, NULL for an absent operand, and NOT of a NULL is not the `true` the Java path gets.
              | if(($sfe.func == not_Boolean_1__Boolean_1_) && !$params->at(0)->meta::relational::m2mSql::isEquality() && $params->at(0)->meta::relational::m2mSql::anySubExpression(e | $e->meta::relational::m2mSql::isEquality()),
                   | 'negation of an expression that combines an equality with other conditions',
                   | $params->map(p | $p->meta::relational::m2mSql::explainUntranslatable($whitelist))->first()
                  )
             )
        );,
    a:ValueSpecification[1] |
      'unsupported expression in transform'
  ]);
}

function <<access.private>> meta::relational::m2mSql::isEquality(vs:ValueSpecification[1]):Boolean[1]
{
  $vs->instanceOf(SimpleFunctionExpression) && ($vs->cast(@SimpleFunctionExpression).func == equal_Any_MANY__Any_MANY__Boolean_1_);
}

// True only for a bare chain of source property accesses rooted at a variable — `$src`,
// `$src.address`, `$src.home.address`. The variable's name is not checked here: by the time this
// runs, explainUntranslatableExpression has already rejected every variable other than $src.
// This is a strictly narrower shape than explainUntranslatableExpression admits, and is the
// precondition jsonProjection.pure's sourceJsonPath needs to turn a complex property's source
// expression into a JSON path. Note that the root `$src` case is admitted here but rejected by
// untranslatablePropertyReasons: its JSON path is empty, which is no path at all.
function meta::relational::m2mSql::isPlainSourceNavigation(vs:ValueSpecification[1]):Boolean[1]
{
  $vs->match(
  [
    v:VariableExpression[1] |
      true,
    sfe:SimpleFunctionExpression[1] |
      $sfe.func->instanceOf(Property)
        && ($sfe.parametersValues->evaluateAndDeactivate()->size() == 1)
        && $sfe.parametersValues->evaluateAndDeactivate()->toOne()->meta::relational::m2mSql::isPlainSourceNavigation(),
    v:ValueSpecification[1] |
      false
  ]);
}

// Re-expresses a root `filter()` lambda, which is over the *target* class, as a boolean over the
// source variable, by replacing each access to a target property with the source expression that
// property is mapped from. Returns [] when the filter cannot be rewritten, or when the rewritten
// expression is not on the SQL whitelist: the caller falls back on either.
function meta::relational::m2mSql::rewriteTargetFilterToSource(filter:LambdaFunction<Any>[1], setImpl:PureInstanceSetImplementation[1], srcVar:VariableExpression[1]):ValueSpecification[0..1]
{
  let parameters = $filter->functionType().parameters->evaluateAndDeactivate();
  let body       = $filter.expressionSequence->evaluateAndDeactivate();
  let rewritten  = if(($parameters->size() != 1) || ($body->size() != 1),
                      | [],
                      | $body->toOne()->meta::relational::m2mSql::rewriteTargetExpression($parameters->at(0).name, $setImpl, $srcVar));
  if($rewritten->isEmpty() || $rewritten->toOne()->meta::relational::m2mSql::explainUntranslatableFilterExpression()->isNotEmpty(),
     | [],
     | $rewritten);
}

function <<access.private>> meta::relational::m2mSql::rewriteTargetExpression(vs:ValueSpecification[1], paramName:String[1], setImpl:PureInstanceSetImplementation[1], srcVar:VariableExpression[1]):ValueSpecification[0..1]
{
  $vs->match(
  [
    // The bare lambda parameter outside a property access has no source-side meaning. No other
    // variable is rewritable either: left in place it could be mistaken for the source variable.
    v:VariableExpression[1] | [],
    sfe:SimpleFunctionExpression[1] |
      let params = $sfe.parametersValues->evaluateAndDeactivate();
      if($sfe.func->instanceOf(Property),
         // Only direct properties of the root target class: $p.name yes, $p.address.city no.
         | if(($params->size() == 1) && $params->at(0)->instanceOf(VariableExpression) && ($params->at(0)->cast(@VariableExpression).name == $paramName),
              | meta::relational::m2mSql::filterableSourceExpression($setImpl, $sfe.func->cast(@Property<Nil,Any|*>), $srcVar),
              | []),
         {|
           let rewritten = $params->map(p | $p->meta::relational::m2mSql::rewriteTargetExpression($paramName, $setImpl, $srcVar));
           if($rewritten->size() != $params->size(),
              | [],
              | ^$sfe(parametersValues = $rewritten)->evaluateAndDeactivate());
         });,
    // A function taking a collection (`plus`, `times`) holds its operands as the values of one
    // InstanceValue; a target property access among them is rewritten like any other.
    i:InstanceValue[1] |
      let rewritten = $i.values->map(v | $v->match([e:ValueSpecification[1] | $e->meta::relational::m2mSql::rewriteTargetExpression($paramName, $setImpl, $srcVar), a:Any[1] | $a]));
      if($rewritten->size() != $i.values->size(),
         | [],
         | ^$i(values = $rewritten)->evaluateAndDeactivate());,
    v:ValueSpecification[1] | []
  ]);
}

// A target property's source expression is only a faithful stand-in for the property's value when the
// value is the transform's result as is: a to-one primitive, mapped by exactly one plain property
// mapping, or auto-mapped the way the M2M store contract auto-maps (by name and type: an unmapped
// property whose same-named source property has another type is empty on the target). An enumeration
// transformer or an explode mapping changes the value or the row it belongs to after the transform has run.
function <<access.private>> meta::relational::m2mSql::filterableSourceExpression(setImpl:PureInstanceSetImplementation[1], property:Property<Nil,Any|*>[1], srcVar:VariableExpression[1]):ValueSpecification[0..1]
{
  let type = $property.genericType.rawType;
  let pms  = $setImpl->meta::relational::m2mSql::purePropertyMappingsFor($property.name->toOne());
  if($type->isEmpty() || !$type->toOne()->instanceOf(PrimitiveType) || !$property.multiplicity->meta::pure::functions::meta::hasToOneUpperBound() || ($pms->size() > 1) || $pms->exists(pm | $pm.transformer->isNotEmpty() || $pm.explodeProperty == true),
     | [],
     | if($pms->isEmpty() && !$property->isPropertyAutoMapped($setImpl),
          | [],
          | meta::relational::m2mSql::sourceExpressionForProperty($setImpl, $property.name->toOne(), $srcVar)));
}

function meta::relational::m2mSql::isSqlTranslatableExpression(vs:ValueSpecification[1]):Boolean[1]
{
  $vs->explainUntranslatableExpression()->isEmpty();
}

// Conservative by design: only arithmetic/string composition proven safe by the parity corpus is
// listed here. Extend only when a new translatable parity case demands it.
function meta::relational::m2mSql::sqlTranslatableFunctionWhitelist():Function<Any>[*]
{
  [
    plus_String_MANY__String_1_,
    plus_Integer_MANY__Integer_1_,
    plus_Float_MANY__Float_1_,
    plus_Number_MANY__Number_1_,
    minus_Number_MANY__Number_1_,
    times_Integer_MANY__Integer_1_,
    times_Number_MANY__Number_1_,
    divide_Number_1__Number_1__Float_1_,
    toOne_T_MANY__T_1_
  ];
}

// Boolean and comparison logic, admitted in filters only (see explainUntranslatableFilterExpression).
function meta::relational::m2mSql::sqlTranslatableFilterFunctions():Function<Any>[*]
{
  [
    and_Boolean_1__Boolean_1__Boolean_1_,
    or_Boolean_1__Boolean_1__Boolean_1_,
    not_Boolean_1__Boolean_1_,
    equal_Any_MANY__Any_MANY__Boolean_1_,
    lessThan_Number_1__Number_1__Boolean_1_,
    lessThanEqual_Number_1__Number_1__Boolean_1_,
    greaterThan_Number_1__Number_1__Boolean_1_,
    greaterThanEqual_Number_1__Number_1__Boolean_1_
  ];
}
