import meta::pure::tools::*;
import meta::relational::m2mSql::*;
import meta::relational::metamodel::*;
import meta::relational::metamodel::relation::*;

// The two SQL statements the executor needs: `setupSqls` load the source document into the synthetic
// table (Task 12 substitutes the {{M2M_INPUT_PATH}} token with the real input location), `sqlQuery`
// returns a single column holding one JSON document per source row.
Class meta::relational::m2mSql::M2MSqlQuery
{
  setupSqls : String[*];
  sqlQuery  : String[1];
}

// One primitive leaf of the target graph fetch tree, flattened to a TDS column of the inner query.
// `path` is the target-tree path to the leaf; `columnName` is that path joined with '__' so nested
// leaves cannot collide with root-level ones. `transform` is the property mapping's own transform
// lambda, re-expressed over the root source variable (nested transforms are composed by substituting
// the parent transform's expression for the nested lambda's $src).
Class meta::relational::m2mSql::M2MSqlColumn
{
  path       : String[*];
  columnName : String[1];
  transform  : LambdaFunction<Any>[1];
  enumCases  : M2MSqlEnumCase[*];
}

// One arm of an enumeration mapping: a source value (an enumeration value is carried as its name) and
// the name of the target enumeration value it maps to. A column with none has no enumeration transformer.
Class meta::relational::m2mSql::M2MSqlEnumCase
{
  sourceValue : Any[1];
  targetName  : String[1];
}

// One nested complex property of the target tree, and the JSON path of the *source* object it is
// built from. The inner query gets an extra boolean column per entry saying whether that source
// object is there at all; without it an absent object and a present object whose selected leaves are
// all null both flatten to the same all-NULL columns, and the outer projection would invent a
// `{"street":null}` where the Java M2M serializer emits `null`.
Class meta::relational::m2mSql::M2MSqlPresenceColumn
{
  columnName : String[1];
  sourcePath : String[1];
}

// What one walk of the target tree yields: the primitive leaf columns the inner `project` produces,
// and the presence columns injected alongside them.
Class meta::relational::m2mSql::M2MSqlProjection
{
  columns   : M2MSqlColumn[*];
  presences : M2MSqlPresenceColumn[*];
}

// Builds the complete SQL for one translatable M2M mapping + target tree: an inner relational query
// (source navigation with the mapping's transforms inlined, planned against the synthetic
// semi-structured source store) wrapped in an outer SELECT whose single column assembles the JSON
// document with DuckDB's json_object/json_array.
function meta::relational::m2mSql::buildM2MSqlQuery(setImpl:PureInstanceSetImplementation[1], targetTree:RootGraphFetchTree<Any>[1], connection:DatabaseConnection[1], extensions:Extension[*], debug:DebugContext[1]):M2MSqlQuery[1]
{
  buildM2MSqlQuery($setImpl, $targetTree, [], $connection, $extensions, $debug);
}

// `rootFilters` are boolean expressions over the root $src variable (see m2mSqlSourceVariable) that
// restrict the source rows on top of the mapping's own ~filter: the query's root `filter()`, already
// rewritten to the source side by rewriteTargetFilterToSource.
function meta::relational::m2mSql::buildM2MSqlQuery(setImpl:PureInstanceSetImplementation[1], targetTree:RootGraphFetchTree<Any>[1], rootFilters:ValueSpecification[*], connection:DatabaseConnection[1], extensions:Extension[*], debug:DebugContext[1]):M2MSqlQuery[1]
{
  let srcClass   = $setImpl.srcClass->toOne()->cast(@Class<Any>);
  let srcVar     = m2mSqlSourceVariable($srcClass);
  let projection = flattenTargetTree($setImpl, $targetTree->cast(@GraphFetchTree), $srcVar, [], $setImpl.parent, $srcClass);
  let columns    = $projection.columns;
  assert($columns->isNotEmpty(), | 'M2M SQL projection needs at least one primitive leaf in the target tree');

  let queryLambda = ^LambdaFunction<{->Any[*]}>
                    (
                      classifierGenericType = ^GenericType
                                              (
                                                rawType       = LambdaFunction,
                                                typeArguments = ^GenericType(rawType = ^FunctionType(returnMultiplicity = PureOne, returnType = ^GenericType(rawType = TabularDataSet)))
                                              ),
                      expressionSequence    = buildProjectExpression($srcClass, $columns, $setImpl->mappingFilterOver($srcVar)->concatenate($rootFilters))
                    );

  // A root filter can read source properties that nothing in the target tree maps from, which the
  // calculated source tree then knows nothing about; the synthetic store only maps what the tree asks for.
  let sourceTree = $rootFilters->fold({f, tree | $tree->ensureFunctionRequirementsFromLambda($srcClass, buildFilterLambda($srcClass, $f), [], false)},
                                      $targetTree->calculateSourceTree($setImpl.parent, $extensions)->cast(@GraphFetchTree))->cast(@RootGraphFetchTree<Any>);
  let source     = synthesizeSourceStore($srcClass, $sourceTree);
  let innerConn  = $connection->withPresenceColumns($source, $projection.presences);
  let plan       = meta::pure::executionPlan::executionPlan($queryLambda, $source.mapping, ^Runtime(connectionStores = ^ConnectionStore(element = $source.database, connection = $innerConn)), $extensions, $debug);
  let innerSql   = $plan.rootExecutionNode->meta::pure::executionPlan::allNodes($extensions)
                                        ->filter(n | $n->instanceOf(meta::relational::mapping::SQLExecutionNode))
                                        ->cast(@meta::relational::mapping::SQLExecutionNode).sqlQuery->toOne();

  let docSql = meta::relational::functions::sqlQueryToString::processOperation(buildJsonDocumentExpression($targetTree->cast(@GraphFetchTree), [], $columns), $connection.type, $extensions);

  let createSql = 'CREATE OR REPLACE TEMP TABLE ' + $source.table.name + ' (' + $source.jsonColumn.name + ' JSON);';
  let insertSql = 'INSERT INTO ' + $source.table.name + ' SELECT to_json(j) FROM read_json(\'{{M2M_INPUT_PATH}}\', format=\'auto\') as j;';
  let outerSql  = 'select ' + $docSql + ' as "' + m2mSqlDocumentColumnName() + '" from (' + $innerSql + ') as "' + m2mSqlSubQueryAlias() + '"';

  ^M2MSqlQuery(setupSqls = [$createSql, $insertSql], sqlQuery = $outerSql);
}

// The alias of the wrapping sub-query and the name of its single JSON column. Both are part of the
// shape Task 12's executor reads back, so they live here rather than as inline literals.
function meta::relational::m2mSql::m2mSqlSubQueryAlias():String[1]
{
  'm2m_sub';
}

function meta::relational::m2mSql::m2mSqlDocumentColumnName():String[1]
{
  'doc';
}

// Column names in this projection are derived from target property names, so they can collide with
// SQL reserved words. Every reference to one is emitted quoted; the SQL generator's identifier
// processor recognises the leading quote and keeps it.
function <<access.private>> meta::relational::m2mSql::m2mSqlQuoteIdentifier(name:String[1]):String[1]
{
  '"' + $name->replace('"', '""') + '"';
}

// The JSON key a property tree contributes, and equally the segment of the flattened column name the
// inner query uses for it. Shared so the two walks below cannot drift apart.
function <<access.private>> meta::relational::m2mSql::pathSegment(propertyTree:PropertyGraphFetchTree[1]):String[1]
{
  $propertyTree.alias->orElse($propertyTree.property.name->toOne());
}

// The inner query's boolean column for one nested complex property. Named off the same flattened
// path as its leaves, with a suffix no Pure property name would collide with by accident.
function <<access.private>> meta::relational::m2mSql::presenceColumnName(path:String[*]):String[1]
{
  $path->joinStrings('__') + '__m2mPresent';
}

// The presence columns cannot go through `project`: the router rejects a projection whose path ends
// on a class, and `isNotEmpty` over a semi-structured navigation routes to an EXISTS sub-select that
// has no join to build. They are injected into the generated SELECT instead, through the connection's
// own SQL post-processor hook, as `json_extract_string("root".data, '$.<path>') is not null`.
function <<access.private>> meta::relational::m2mSql::withPresenceColumns(connection:DatabaseConnection[1], source:M2MSqlSourceStore[1], presences:M2MSqlPresenceColumn[*]):DatabaseConnection[1]
{
  if($presences->isEmpty(),
     | $connection,
     {|
       let jsonRead = ^TableAliasColumn(alias = $source.rootSet.mainTableAlias, column = $source.jsonColumn);
       let aliases  = $presences->map(p |
                        ^Alias
                        (
                          name               = m2mSqlQuoteIdentifier($p.columnName),
                          relationalElement  = ^DynaFunction
                                               (
                                                 name       = 'isNotNull',
                                                 parameters = ^DynaFunction
                                                              (
                                                                name       = 'extractFromSemiStructured',
                                                                parameters = [$jsonRead, ^Literal(value = $p.sourcePath), ^Literal(value = 'VARCHAR')]
                                                              )
                                               )
                        )
                      );
       ^$connection(sqlQueryPostProcessors = $connection.sqlQueryPostProcessors->concatenate(
          {q:meta::relational::metamodel::relation::SelectSQLQuery[1] | ^Result<meta::relational::metamodel::relation::SelectSQLQuery|1>(values = ^$q(columns = $q.columns->concatenate($aliases)))}
       ));
     }
    );
}

// The JSON path, from the source document root, of the object a composed source expression navigates
// to. Only a plain chain of property accesses rooted at $src can be expressed as a JSON path, which
// is all canPlanM2MSql admits for a complex property (its type would not otherwise check out).
function <<access.private>> meta::relational::m2mSql::sourceJsonPath(vs:ValueSpecification[1]):String[*]
{
  $vs->match(
  [
    v:VariableExpression[1] | [],
    sfe:SimpleFunctionExpression[1] |
      assert($sfe.func->instanceOf(Property), | 'M2M SQL presence check needs a plain source navigation, found ' + $sfe.functionName->orElse($sfe.func->elementToPath()));
      $sfe.parametersValues->evaluateAndDeactivate()->toOne()->sourceJsonPath()->concatenate($sfe.func->cast(@Property<Nil,Any|*>).name->toOne());,
    v:ValueSpecification[1] |
      fail('M2M SQL presence check needs a plain source navigation'); [];
  ]);
}

// (a) Flatten the target tree to columns. `srcExpr` is the source-side expression, in terms of the
// root $src variable, that the current set implementation's transforms apply to: the root variable
// itself at the top level, and the parent complex property's transform below that.
function <<access.private>> meta::relational::m2mSql::flattenTargetTree(setImpl:PureInstanceSetImplementation[1], tree:GraphFetchTree[1], srcExpr:ValueSpecification[1], prefix:String[*], mapping:Mapping[1], rootSrcClass:Class<Any>[1]):M2MSqlProjection[1]
{
  let parts = $tree.propertyTrees()->map(pt |
    let path    = $prefix->concatenate($pt->pathSegment());
    let pms     = $setImpl->purePropertyMappingsFor($pt.property.name->toOne());
    let derived = sourceExpressionForProperty($setImpl, $pt.property.name->toOne(), $srcExpr);
    assert($derived->isNotEmpty(), | 'no property mapping and no auto-mappable source property named ' + $pt.property.name->toOne() + ' on ' + $setImpl.srcClass->toOne()->elementToPath());
    let expr    = $derived->toOne();
    if($pt.subTrees->isEmpty(),
       | ^M2MSqlProjection(columns = ^M2MSqlColumn
                                     (
                                       path       = $path,
                                       columnName = $path->joinStrings('__'),
                                       transform  = buildColumnLambda($rootSrcClass, $expr),
                                       enumCases  = $pms.transformer->filter(t | $t->instanceOf(EnumerationMapping))->cast(@EnumerationMapping<Any>).enumValueMappings
                                                        ->map(evm | $evm.sourceValues->map(v | ^M2MSqlEnumCase(sourceValue = $v->match([e:Enum[1] | $e.name, a:Any[1] | $a]), targetName = $evm.enum.name)))
                                     )),
       | // A to-many complex property would need one JSON object per source element, which this flat
         // single-row projection cannot express. canPlanM2MSql rejects it; this is the backstop for a
         // direct caller that skipped the gate.
         assert($pt.property.multiplicity->meta::pure::functions::meta::hasToOneUpperBound(), | 'to-many complex property ' + $pt.property.name->toOne() + ' is not supported by the M2M SQL projection');
         let nested = nestedSetImplementation($pms, $pt, $mapping);
         let sub    = flattenTargetTree($nested, $pt->cast(@GraphFetchTree), $expr, $path, $mapping, $rootSrcClass);
         ^M2MSqlProjection
         (
           columns   = $sub.columns,
           presences = ^M2MSqlPresenceColumn(columnName = presenceColumnName($path), sourcePath = $expr->sourceJsonPath()->joinStrings('.'))->concatenate($sub.presences)
         );
      );
  );
  ^M2MSqlProjection(columns = $parts.columns, presences = $parts.presences);
}

function meta::relational::m2mSql::purePropertyMappingsFor(setImpl:PureInstanceSetImplementation[1], propertyName:String[1]):PurePropertyMapping[*]
{
  $setImpl->propertyMappingsByPropertyName($propertyName)->filter(pm | $pm->instanceOf(PurePropertyMapping))->cast(@PurePropertyMapping);
}

// The source-side expression a target property is populated from, over `srcExpr`: its property
// mapping's transform when it has one, the same-named source property when it is auto-mapped, and
// [] when it is neither.
function meta::relational::m2mSql::sourceExpressionForProperty(setImpl:PureInstanceSetImplementation[1], propertyName:String[1], srcExpr:ValueSpecification[1]):ValueSpecification[0..1]
{
  let pms = $setImpl->purePropertyMappingsFor($propertyName);
  if($pms->isEmpty(),
     | autoMappedSourceExpression($setImpl, $propertyName, $srcExpr),
     | substituteSourceVariable($pms->at(0).transform, $srcExpr));
}

// An auto-mapped property has no property mapping at all: the source class carries a property of the
// same name, and the M2M store contract treats it as an identity pass-through. The equivalent
// transform is a plain property access on the current source expression.
function <<access.private>> meta::relational::m2mSql::autoMappedSourceExpression(setImpl:PureInstanceSetImplementation[1], propertyName:String[1], srcExpr:ValueSpecification[1]):ValueSpecification[0..1]
{
  let srcClass    = $setImpl.srcClass->toOne()->cast(@Class<Any>);
  let srcProperty = $srcClass->propertyByName($propertyName);
  if($srcProperty->isEmpty(),
     | [],
     | ^SimpleFunctionExpression
       (
         func             = $srcProperty->toOne(),
         functionName     = $propertyName,
         importGroup      = system::imports::coreImport,
         genericType      = $srcProperty->toOne()->functionReturnType(),
         multiplicity     = $srcProperty->toOne().multiplicity,
         parametersValues = $srcExpr
       )->evaluateAndDeactivate());
}

function <<access.private>> meta::relational::m2mSql::nestedSetImplementation(pms:PurePropertyMapping[*], propertyTree:PropertyGraphFetchTree[1], mapping:Mapping[1]):PureInstanceSetImplementation[1]
{
  let resolved = if($pms->isEmpty(),
                    | $mapping->rootClassMappingByClass($propertyTree.property.genericType.rawType->toOne()->cast(@Class<Any>)),
                    | resolveNestedSetImplementation($pms->at(0), $mapping));
  assert($resolved->isNotEmpty() && $resolved->toOne()->instanceOf(PureInstanceSetImplementation), | 'could not resolve the nested class mapping for property ' + $propertyTree.property.name->toOne());
  $resolved->toOne()->cast(@PureInstanceSetImplementation);
}

// The root source variable every column and filter lambda of the inner query is expressed over.
function <<access.private>> meta::relational::m2mSql::m2mSqlSourceVariable(srcClass:Class<Any>[1]):VariableExpression[1]
{
  ^VariableExpression(name = 'src', genericType = ^GenericType(rawType = $srcClass), multiplicity = PureOne);
}

// The set implementation's ~filter, if it has one, re-expressed over `srcVar`: the filter lambda's own
// parameter is not guaranteed to be named `src`, which is the only variable the whitelist admits.
function <<access.private>> meta::relational::m2mSql::mappingFilterOver(setImpl:PureInstanceSetImplementation[1], srcVar:ValueSpecification[1]):ValueSpecification[0..1]
{
  if($setImpl.filter->isEmpty(), | [], | substituteSourceVariable($setImpl.filter->toOne(), $srcVar));
}

// Re-expresses a property mapping's transform over the enclosing source expression by replacing its
// own $src parameter. At the root this is the identity (the replacement *is* the root variable);
// below the root it is what composes `target.address.street` into a single navigation of the source
// document.
function <<access.private>> meta::relational::m2mSql::substituteSourceVariable(transform:LambdaFunction<Any>[1], replacement:ValueSpecification[1]):ValueSpecification[1]
{
  let parameters = $transform->functionType().parameters->evaluateAndDeactivate();
  assert($parameters->size() == 1, | 'expected a single-parameter transform lambda');
  $transform.expressionSequence->evaluateAndDeactivate()->toOne()->replaceVariable($parameters->at(0).name, $replacement);
}

function <<access.private>> meta::relational::m2mSql::replaceVariable(vs:ValueSpecification[1], name:String[1], replacement:ValueSpecification[1]):ValueSpecification[1]
{
  $vs->match(
  [
    v:VariableExpression[1]        | if($v.name == $name, | $replacement, | $v),
    fe:SimpleFunctionExpression[1] | ^$fe(parametersValues = $fe.parametersValues->evaluateAndDeactivate()->map(p | $p->replaceVariable($name, $replacement)))->evaluateAndDeactivate(),
    v:ValueSpecification[1]        | $v
  ]);
}

function <<access.private>> meta::relational::m2mSql::buildColumnLambda(srcClass:Class<Any>[1], expr:ValueSpecification[1]):LambdaFunction<Any>[1]
{
  buildSourceLambda($srcClass, $expr, $expr.genericType, $expr.multiplicity);
}

function <<access.private>> meta::relational::m2mSql::buildFilterLambda(srcClass:Class<Any>[1], expr:ValueSpecification[1]):LambdaFunction<Any>[1]
{
  buildSourceLambda($srcClass, $expr, ^GenericType(rawType = Boolean), PureOne);
}

function <<access.private>> meta::relational::m2mSql::buildSourceLambda(srcClass:Class<Any>[1], expr:ValueSpecification[1], returnType:GenericType[1], returnMultiplicity:Multiplicity[1]):LambdaFunction<Any>[1]
{
  ^LambdaFunction<{Nil[1]->Any[*]}>
  (
    classifierGenericType = ^GenericType
                            (
                              rawType       = LambdaFunction,
                              typeArguments = ^GenericType
                                              (
                                                rawType = ^FunctionType
                                                          (
                                                            parameters         = m2mSqlSourceVariable($srcClass),
                                                            returnMultiplicity = $returnMultiplicity,
                                                            returnType         = $returnType
                                                          )
                                              )
                            ),
    expressionSequence    = $expr
  );
}

// (b) `srcClass.all()->filter(<filter>)...->project([<transforms>], [<column names>])`, built by hand
// because the transforms come from the mapping rather than from parsed source. `filters` are boolean
// expressions over the root $src variable, ANDed by applying one `filter` per entry.
function <<access.private>> meta::relational::m2mSql::buildProjectExpression(srcClass:Class<Any>[1], columns:M2MSqlColumn[*], filters:ValueSpecification[*]):FunctionExpression[1]
{
  let getAll = ^SimpleFunctionExpression
               (
                 func             = getAll_Class_1__T_MANY_,
                 functionName     = 'getAll',
                 importGroup      = system::imports::coreImport,
                 genericType      = ^GenericType(rawType = $srcClass),
                 multiplicity     = ZeroMany,
                 parametersValues = ^InstanceValue(values = $srcClass, genericType = ^GenericType(rawType = Class, typeArguments = ^GenericType(rawType = $srcClass)), multiplicity = PureOne)
               )->evaluateAndDeactivate();

  // pureToSQLQuery's processFilter reads the lambda's FunctionType off the InstanceValue's generic
  // type, so it has to be the lambda's real classifier type and not the loose one `project` accepts.
  let filtered = $filters->fold({f, acc |
    let filterLambda = buildFilterLambda($srcClass, $f);
    ^SimpleFunctionExpression
    (
      func             = filter_T_MANY__Function_1__T_MANY_,
      functionName     = 'filter',
      importGroup      = system::imports::coreImport,
      genericType      = ^GenericType(rawType = $srcClass),
      multiplicity     = ZeroMany,
      parametersValues = [$acc, ^InstanceValue(genericType = $filterLambda.classifierGenericType->toOne(), multiplicity = PureOne, values = $filterLambda)]
    )->evaluateAndDeactivate()->cast(@ValueSpecification);
  },$getAll->cast(@ValueSpecification));

  ^SimpleFunctionExpression
  (
    func             = project_K_MANY__Function_MANY__String_MANY__TabularDataSet_1_,
    functionName     = 'project',
    importGroup      = system::imports::coreImport,
    genericType      = ^GenericType(rawType = TabularDataSet),
    multiplicity     = PureOne,
    parametersValues = [
                        $filtered,
                        ^InstanceValue(genericType = ^GenericType(rawType = FunctionDefinition, typeArguments = ^GenericType(rawType = Any)), multiplicity = ZeroMany, values = $columns.transform),
                        ^InstanceValue(genericType = ^GenericType(rawType = String), multiplicity = ZeroMany, values = $columns.columnName)
                       ]
  )->evaluateAndDeactivate();
}

// (c) The outer JSON document, mirroring the target tree's nesting. Leaves reference the inner
// query's columns by the same flattened name flattenTargetTree assigned them; a nested object is
// guarded by that subtree's presence column so an absent source object serialises as `null` and not
// as a structure of null leaves.
//
// A missing optional primitive deliberately serialises as an explicit `null`: that is what the Java
// M2M serializer emits too (verified end to end in TestM2MSqlParity), so there is nothing to omit.
function <<access.private>> meta::relational::m2mSql::buildJsonDocumentExpression(tree:GraphFetchTree[1], prefix:String[*], columns:M2MSqlColumn[*]):RelationalOperationElement[1]
{
  let parameters = $tree.propertyTrees()->map(pt |
    let segment = $pt->pathSegment();
    let path    = $prefix->concatenate($segment);
    let value   = if($pt.subTrees->isEmpty(),
                     | let columnName = $path->joinStrings('__');
                       let enumCases  = $columns->filter(c | $c.columnName == $columnName).enumCases;
                       if($enumCases->isEmpty(),
                          | m2mSqlLeafReference($columnName, !$pt.property.multiplicity->meta::pure::functions::meta::hasToOneUpperBound()),
                          | m2mSqlEnumCaseReference($columnName, $enumCases, $pt.property.name->toOne()));,
                     | ^DynaFunction
                       (
                         name       = 'if',
                         parameters = [
                                        m2mSqlColumnReference(presenceColumnName($path)),
                                        buildJsonDocumentExpression($pt->cast(@GraphFetchTree), $path, $columns),
                                        ^Literal(value = ^meta::relational::metamodel::SQLNull())
                                      ]
                       )->cast(@RelationalOperationElement));
    [^Literal(value = $segment)->cast(@RelationalOperationElement), $value];
  );
  ^DynaFunction(name = 'jsonObject', parameters = $parameters);
}

// A collection leaf arrives from the inner query as the *text* of a JSON array (the semi-structured
// extract is typed VARCHAR — see meta::relational::m2mSql::pureTypeToSemiStructuredExtractType), so
// it has to be re-parsed to nest as a real array rather than as a quoted string. To-one leaves need
// no such treatment: root-level ones are already SQL scalars and nested ones are already JSON.
function <<access.private>> meta::relational::m2mSql::m2mSqlLeafReference(columnName:String[1], isCollection:Boolean[1]):RelationalOperationElement[1]
{
  let ref = m2mSqlColumnReference($columnName);
  if($isCollection, | ^DynaFunction(name = 'parseJson', parameters = $ref)->cast(@RelationalOperationElement), | $ref);
}

// The enumeration mapping of one column, as a CASE over the inner query's raw source value. A source
// value with no arm raises, as the Java path does for a value the enumeration mapping does not know;
// DuckDB only evaluates `error` for a row that reaches it. An absent value stays null.
function <<access.private>> meta::relational::m2mSql::m2mSqlEnumCaseReference(columnName:String[1], cases:M2MSqlEnumCase[*], propertyName:String[1]):RelationalOperationElement[1]
{
  let ref     = m2mSqlColumnReference($columnName);
  let matched = $cases->reverse()->fold({c, acc |
    ^DynaFunction
    (
      name       = 'if',
      parameters = [
                     ^DynaFunction(name = 'equal', parameters = [$ref, ^Literal(value = $c.sourceValue)]),
                     ^Literal(value = $c.targetName),
                     $acc
                   ]
    )->cast(@RelationalOperationElement)
  }, ^DynaFunction(name = 'sqlError', parameters = ^Literal(value = 'Unmatched enum source value for property ' + $propertyName))->cast(@RelationalOperationElement));
  ^DynaFunction(name = 'if', parameters = [^DynaFunction(name = 'isNull', parameters = $ref), ^Literal(value = ^meta::relational::metamodel::SQLNull()), $matched]);
}

// A reference to one column of the wrapping sub-query. The database/schema/table around it are
// throwaway scaffolding: only the alias and column names survive into the generated SQL.
//
// The name is pre-quoted: the inner query already emits its aliases quoted (they come straight from
// target property names, so one of them being a reserved word is a matter of time), and the SQL
// generator's identifier processor treats an already-quoted identifier as one to keep quoted.
function <<access.private>> meta::relational::m2mSql::m2mSqlColumnReference(columnName:String[1]):RelationalOperationElement[1]
{
  let database = ^Database(name = 'm2mSqlWrapperDb', package = meta::relational::m2mSql);
  let schema   = ^Schema(name = 'default', database = $database);
  let table    = ^Table(name = m2mSqlSubQueryAlias(), schema = $schema);
  let column   = ^Column(name = m2mSqlQuoteIdentifier($columnName), type = ^meta::relational::metamodel::datatype::Varchar(size = 8192));
  ^TableAliasColumn(alias = ^TableAlias(database = $database, name = m2mSqlSubQueryAlias(), relationalElement = $table), column = $column)->cast(@RelationalOperationElement);
}
