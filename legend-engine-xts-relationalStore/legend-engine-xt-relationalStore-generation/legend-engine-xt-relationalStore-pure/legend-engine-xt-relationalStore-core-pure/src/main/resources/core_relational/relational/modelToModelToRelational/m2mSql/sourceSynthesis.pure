import meta::external::format::shared::binding::*;
import meta::pure::graphFetch::*;
import meta::pure::mapping::*;
import meta::pure::metamodel::function::property::*;
import meta::pure::metamodel::type::*;
import meta::pure::model::unit::*;
import meta::relational::m2mSql::*;
import meta::relational::mapping::*;
import meta::relational::metamodel::*;
import meta::relational::metamodel::relation::*;

// The single synthetic relational store that stands in for an M2M source class: one table with one
// JSON column, plus a mapping that reads the source class' properties back out of that column by
// semi-structured navigation. Task 11 plans queries against `mapping` and executes them against a
// DuckDB view over `table`, so all five pieces are handed back together.
Class meta::relational::m2mSql::M2MSqlSourceStore
{
  database   : Database[1];
  table      : Table[1];
  jsonColumn : Column[1];
  mapping    : Mapping[1];
  rootSet    : RootRelationalInstanceSetImplementation[1];
}

// Builds the synthetic store for one source class. Only the properties the source tree actually
// asks for are mapped: primitives become `extractFromSemiStructured` reads off the JSON column,
// complex properties become semi-structured embedded sets whose own nested property mappings are
// synthesized lazily by meta::relational::mapping::buildSemiStructuredPropertyMapping during
// planning.
function meta::relational::m2mSql::synthesizeSourceStore(srcClass:Class<Any>[1], sourceTree:RootGraphFetchTree<Any>[1]):M2MSqlSourceStore[1]
{
  let db      = ^Database(name = 'm2mSqlSourceDb', package = meta::relational::m2mSql);
  let schema  = ^Schema(name = 'default', database = $db);
  let jsonCol = ^Column(name = 'data', type = ^meta::relational::metamodel::datatype::SemiStructured());
  let table   = ^Table(name = 'm2m_src_0', schema = $schema, columns = $jsonCol, primaryKey = $jsonCol);

  $db->mutateAdd('schemas', $schema);
  $schema->mutateAdd('tables', $table);

  let alias   = ^TableAlias(database = $db, name = 'root', relationalElement = $table);
  let mapping = ^Mapping(name = 'm2mSqlSourceMapping', package = meta::relational::m2mSql);

  let set = ^RootRelationalInstanceSetImplementation
            (
              id                    = $srcClass.name->toOne(),
              root                  = true,
              parent                = $mapping,
              class                 = $srcClass,
              mainTableAlias        = $alias,
              userDefinedPrimaryKey = true,
              primaryKey            = ^TableAliasColumn(alias = $alias, column = $jsonCol)
            );

  // One binding for the whole synthetic store. Only `contentType` is consulted from here on:
  // meta::relational::mapping::buildSemiStructuredPropertyMapping reads it when it synthesizes the
  // nested property mappings during planning. The model unit is informational.
  let binding = ^Binding
                (
                  name        = 'm2mSqlSourceBinding',
                  package     = meta::relational::m2mSql,
                  contentType = 'application/json',
                  modelUnit   = ^ModelUnit(packageableElementIncludes = $srcClass)
                );

  let propertyMappings = $sourceTree.propertyTrees().property->map(p | $p->buildSourcePropertyMapping($set, $alias, $jsonCol, $mapping, $binding));

  $set->mutateAdd('propertyMappings', $propertyMappings);
  $mapping->mutateAdd('classMappings', $set);

  ^M2MSqlSourceStore
  (
    database   = $db,
    table      = $table,
    jsonColumn = $jsonCol,
    mapping    = $mapping,
    rootSet    = $set
  );
}

function <<access.private>> meta::relational::m2mSql::buildSourcePropertyMapping(property:AbstractProperty<Any>[1], set:RootRelationalInstanceSetImplementation[1], alias:TableAlias[1], jsonColumn:Column[1], mapping:Mapping[1], binding:Binding[1]):PropertyMapping[1]
{
  let returnType = $property->functionReturnType().rawType->toOne();
  let jsonRead   = ^TableAliasColumn(alias = $alias, column = $jsonColumn);

  if($returnType->instanceOf(DataType),
     | ^RelationalPropertyMapping
       (
         property                   = $property->cast(@Property<Nil,Any|*>),
         sourceSetImplementationId  = $set.id,
         targetSetImplementationId  = '',
         owner                      = $set,
         relationalOperationElement = ^DynaFunction
                                      (
                                        name       = 'extractFromSemiStructured',
                                        parameters = [
                                                       $jsonRead,
                                                       ^Literal(value = $property.name->toOne()),
                                                       ^Literal(value = $returnType->pureTypeToSemiStructuredExtractType())
                                                     ]
                                      )
       ),
     | let propertyClass = $returnType->cast(@Class<Any>);
       let setId = $set.id + '_' + $property.name->toOne();
       ^SemiStructuredEmbeddedRelationalInstanceSetImplementation
       (
         id                         = $setId,
         root                       = false,
         class                      = $propertyClass,
         parent                     = $mapping,
         setMappingOwner            = $set,
         sourceSetImplementationId  = $set.id,
         targetSetImplementationId  = $setId,
         owner                      = $set,
         property                   = $property->cast(@Property<Nil,Any|*>),
         relationalOperationElement = ^meta::relational::metamodel::operation::SemiStructuredPropertyAccess
                                      (
                                        operand     = $jsonRead,
                                        property    = ^Literal(value = $property.name->toOne()),
                                        returnType  = $propertyClass,
                                        contentType = 'application/json'
                                      ),
         transformer                = ^BindingTransformer<Any>(binding = $binding, class = $propertyClass)
       );
    );
}

// The source property types the collapse lets the synthetic store extract: the ones the parity corpus
// proves read and serialize as the Java path does. pureTypeToSemiStructuredExtractType knows more, but
// Float (32-bit in DuckDB unnest), Decimal (DECIMAL(18,3)) and the date types (DuckDB's own timestamp
// text) are not established to match, so a query reading one falls back. The collapse checks the
// source tree against this before synthesis, which also keeps it clear of the `fail` below.
function meta::relational::m2mSql::isExtractableSourceType(t:Type[1]):Boolean[1]
{
  $t->instanceOf(Enumeration) || $t->in(meta::relational::m2mSql::provenPrimitiveTypes());
}

function meta::relational::m2mSql::provenPrimitiveTypes():PrimitiveType[*]
{
  [String, Integer, Boolean];
}

function <<access.private>> meta::relational::m2mSql::pureTypeToSemiStructuredExtractType(t:Type[1]):String[1]
{
  // An enumeration value is its name in the source JSON, and its name again in the serialized target.
  if($t->instanceOf(Enumeration), | 'VARCHAR',
  | if($t == String,              | 'VARCHAR',
  // Pure's Integer is 64-bit.
  | if($t == Integer,             | 'BIGINT',
  | if($t == Float,               | 'FLOAT',
  | if($t == Decimal,             | 'DECIMAL',
  | if($t == Boolean,             | 'BOOLEAN',
  | if($t == StrictDate,          | 'DATE',
  | if($t->in([Date, DateTime]),  | 'TIMESTAMP',
  | fail('Unsupported source primitive for M2M SQL: ' + $t->cast(@PackageableElement)->elementToPath()); 'VARCHAR';))))))));
}
