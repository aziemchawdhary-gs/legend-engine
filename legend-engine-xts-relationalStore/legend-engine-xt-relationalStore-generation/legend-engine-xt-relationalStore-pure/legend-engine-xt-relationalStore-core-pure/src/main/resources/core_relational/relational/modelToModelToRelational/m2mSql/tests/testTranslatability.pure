  let tree    = #{meta::relational::m2mSql::tests::enumTransform::Item{color}}#->cast(@RootGraphFetchTree<Any>);

  let result = canPlanM2MSql($setImpl, $tree, $mapping);
  assertFalse($result.translatable);
  assert($result.reason->isNotEmpty() && $result.reason->toOne()->toLower()->contains('enumeration'), | 'expected reason to mention enumeration, got: ' + $result.reason->orElse('<none>'));
}

