###Pure
import meta::relational::m2mSql::*;
import meta::pure::mapping::*;
import meta::external::store::model::*;
import meta::pure::graphFetch::*;

function <<test.Test>> meta::relational::m2mSql::tests::testSimpleRenameIsTranslatable():Boolean[1]
{
  let mapping = meta::relational::m2mSql::tests::simpleRename::TestMapping;
  let setImpl = $mapping->rootClassMappingByClass(meta::relational::m2mSql::tests::simpleRename::Person)->cast(@PureInstanceSetImplementation)->toOne();
  let tree    = #{meta::relational::m2mSql::tests::simpleRename::Person{fullName}}#->cast(@RootGraphFetchTree<Any>);

  let result = canPlanM2MSql($setImpl, $tree, $mapping);
  assert($result.translatable, | 'expected simple rename mapping to be translatable, got reason: ' + $result.reason->orElse(''));
}

function <<test.Test>> meta::relational::m2mSql::tests::testRootMappingFilterIsTranslatable():Boolean[1]
{
  let mapping = meta::relational::m2mSql::tests::mappingFilter::TestMapping;
  let setImpl = $mapping->rootClassMappingByClass(meta::relational::m2mSql::tests::mappingFilter::Person)->cast(@PureInstanceSetImplementation)->toOne();
  let tree    = #{meta::relational::m2mSql::tests::mappingFilter::Person{name}}#->cast(@RootGraphFetchTree<Any>);

  let result = canPlanM2MSql($setImpl, $tree, $mapping);
  assert($result.translatable, | 'expected a boolean root mapping filter to be translatable, got reason: ' + $result.reason->orElse(''));
}

// Uses every comparison/boolean function on the whitelist, so a grammar operator resolving to an
// overload other than the whitelisted one shows up here rather than as a silent fallback.
function <<test.Test>> meta::relational::m2mSql::tests::testComparisonMappingFilterIsTranslatable():Boolean[1]
{
  let mapping = meta::relational::m2mSql::tests::comparisonFilter::TestMapping;
  let setImpl = $mapping->rootClassMappingByClass(meta::relational::m2mSql::tests::comparisonFilter::Person)->cast(@PureInstanceSetImplementation)->toOne();
  let tree    = #{meta::relational::m2mSql::tests::comparisonFilter::Person{name}}#->cast(@RootGraphFetchTree<Any>);

  let result = canPlanM2MSql($setImpl, $tree, $mapping);
  assert($result.translatable, | 'expected a comparison/boolean root mapping filter to be translatable, got reason: ' + $result.reason->orElse(''));
}

function <<test.Test>> meta::relational::m2mSql::tests::testUntranslatableMappingFilterIsNotTranslatable():Boolean[1]
{
  let mapping = meta::relational::m2mSql::tests::untranslatableFilter::TestMapping;
  let setImpl = $mapping->rootClassMappingByClass(meta::relational::m2mSql::tests::comparisonFilter::Person)->cast(@PureInstanceSetImplementation)->toOne();
  let tree    = #{meta::relational::m2mSql::tests::comparisonFilter::Person{name}}#->cast(@RootGraphFetchTree<Any>);

  let result = canPlanM2MSql($setImpl, $tree, $mapping);
  assertFalse($result.translatable);
  assertEquals('unsupported mapping filter: unsupported function in transform: trim', $result.reason->orElse('<none>'));
}

function <<test.Test>> meta::relational::m2mSql::tests::testNestedMappingFilterIsNotTranslatable():Boolean[1]
{
  let mapping = meta::relational::m2mSql::tests::nestedFilter::TestMapping;
  let setImpl = $mapping->rootClassMappingByClass(meta::relational::m2mSql::tests::nestedFilter::Person)->cast(@PureInstanceSetImplementation)->toOne();
  let tree    = #{meta::relational::m2mSql::tests::nestedFilter::Person{name, address{city}}}#->cast(@RootGraphFetchTree<Any>);

  let result = canPlanM2MSql($setImpl, $tree, $mapping);
  assertFalse($result.translatable);
  assertEquals('mapping filter not yet translated', $result.reason->orElse('<none>'));
}

function <<test.Test>> meta::relational::m2mSql::tests::testEnumTransformerIsNotTranslatable():Boolean[1]
{
  let mapping = meta::relational::m2mSql::tests::enumTransform::TestMapping;
  let setImpl = $mapping->rootClassMappingByClass(meta::relational::m2mSql::tests::enumTransform::Item)->cast(@PureInstanceSetImplementation)->toOne();
  let tree    = #{meta::relational::m2mSql::tests::enumTransform::Item{color}}#->cast(@RootGraphFetchTree<Any>);

  let result = canPlanM2MSql($setImpl, $tree, $mapping);
  assertFalse($result.translatable);
  assert($result.reason->isNotEmpty() && $result.reason->toOne()->toLower()->contains('enumeration'), | 'expected reason to mention enumeration, got: ' + $result.reason->orElse('<none>'));
}

function <<test.Test>> meta::relational::m2mSql::tests::testExplodePropertyMappingIsNotTranslatable():Boolean[1]
{
  let mapping = meta::relational::m2mSql::tests::explodeMapping::TestMapping;
  let setImpl = $mapping->rootClassMappingByClass(meta::relational::m2mSql::tests::explodeMapping::Tag)->cast(@PureInstanceSetImplementation)->toOne();
  let tree    = #{meta::relational::m2mSql::tests::explodeMapping::Tag{name}}#->cast(@RootGraphFetchTree<Any>);

