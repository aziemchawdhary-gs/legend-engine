function meta::relational::m2mSql::tests::rewriteRootFilter(filter:meta::pure::metamodel::function::LambdaFunction<Any>[1], mapping:Mapping[1], targetClass:Class<Any>[1]):meta::pure::metamodel::valuespecification::ValueSpecification[0..1]
{
  let setImpl = $mapping->rootClassMappingByClass($targetClass)->cast(@PureInstanceSetImplementation)->toOne();
  let srcVar  = ^meta::pure::metamodel::valuespecification::VariableExpression(name = 'src', genericType = ^GenericType(rawType = $setImpl.srcClass->toOne()), multiplicity = PureOne);
  rewriteTargetFilterToSource($filter, $setImpl, $srcVar);
}

// The names of the properties an expression reads, in evaluation order, and the variables it reads
// them from: enough to tell a source-side expression from a target-side one.
function meta::relational::m2mSql::tests::propertiesAndVariables(vs:meta::pure::metamodel::valuespecification::ValueSpecification[1]):String[*]
{
  $vs->match(
  [
    v:meta::pure::metamodel::valuespecification::VariableExpression[1] | '$' + $v.name,
    sfe:meta::pure::metamodel::valuespecification::SimpleFunctionExpression[1] |
      let inner = $sfe.parametersValues->evaluateAndDeactivate()->map(p | $p->meta::relational::m2mSql::tests::propertiesAndVariables());
      if($sfe.func->instanceOf(meta::pure::metamodel::function::property::Property), | $inner->concatenate($sfe.func.name->toOne()), | $inner);,
    // A function taking a collection (`plus`) holds its operands as the values of one InstanceValue.
    i:meta::pure::metamodel::valuespecification::InstanceValue[1] |
      $i.values->filter(v | $v->instanceOf(meta::pure::metamodel::valuespecification::ValueSpecification))
               ->cast(@meta::pure::metamodel::valuespecification::ValueSpecification)
               ->map(v | $v->meta::relational::m2mSql::tests::propertiesAndVariables()),
    a:meta::pure::metamodel::valuespecification::ValueSpecification[1] | []
  ]);
}

