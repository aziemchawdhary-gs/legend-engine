function <<test.Test>> meta::relational::m2mSql::tests::testNonNavigationComplexPropertyIsNotTranslatable():Boolean[1]
{
  let mapping = meta::relational::m2mSql::tests::toOneComplex::TestMapping;
  let setImpl = $mapping->rootClassMappingByClass(meta::relational::m2mSql::tests::toOneComplex::Person)->cast(@PureInstanceSetImplementation)->toOne();
  let tree    = #{meta::relational::m2mSql::tests::toOneComplex::Person{address{city}}}#->cast(@RootGraphFetchTree<Any>);

  // Pin the precondition, so this cannot start passing for an unrelated reason: every *other* check
  // in the gate accepts this transform.
  let transform = $setImpl->propertyMappingsByPropertyName('address')->at(0)->cast(@PurePropertyMapping).transform.expressionSequence->toOne();
  assert($transform->meta::relational::m2mSql::explainUntranslatableExpression()->isEmpty(), | 'expected ->toOne() to be accepted by the expression whitelist');

  let result = canPlanM2MSql($setImpl, $tree, $mapping);
  assertFalse($result.translatable, | 'expected a non-navigation complex property transform to be rejected');
  assert($result.reason->toOne()->contains('plain source navigation'), | 'expected a plain-source-navigation reason, got: ' + $result.reason->orElse(''));
}

// The complement of the case above: a bare `$src` clears both the expression whitelist and the
// plain-navigation check, but jsonProjection.pure's sourceJsonPath would hand the presence column an
// empty JSON path, so the gate has to reject it in its own right.
function <<test.Test>> meta::relational::m2mSql::tests::testBareSourceComplexPropertyIsNotTranslatable():Boolean[1]
{
  let mapping = meta::relational::m2mSql::tests::selfSource::TestMapping;
  let setImpl = $mapping->rootClassMappingByClass(meta::relational::m2mSql::tests::selfSource::Wrapper)->cast(@PureInstanceSetImplementation)->toOne();

  // Pin the preconditions, so this cannot start passing for an unrelated reason.
  let transform = $setImpl->propertyMappingsByPropertyName('inner')->at(0)->cast(@PurePropertyMapping).transform.expressionSequence->toOne();
  assert($transform->meta::relational::m2mSql::explainUntranslatableExpression()->isEmpty(), | 'expected a bare $src to be accepted by the expression whitelist');
  assert($transform->meta::relational::m2mSql::isPlainSourceNavigation(), | 'expected a bare $src to be accepted as a plain source navigation');

  let tree   = #{meta::relational::m2mSql::tests::selfSource::Wrapper{inner{value}}}#->cast(@RootGraphFetchTree<Any>);
  let result = canPlanM2MSql($setImpl, $tree, $mapping);
  assertFalse($result.translatable, | 'expected a complex property mapped to the bare source object to be rejected');
  assert($result.reason->toOne()->contains('source property access'), | 'expected a source-property-access reason, got: ' + $result.reason->orElse(''));
}

