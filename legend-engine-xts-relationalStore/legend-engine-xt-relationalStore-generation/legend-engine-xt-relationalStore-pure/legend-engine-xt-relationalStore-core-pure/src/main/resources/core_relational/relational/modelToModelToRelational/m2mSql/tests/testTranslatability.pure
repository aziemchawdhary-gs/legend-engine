###Pure
import meta::relational::m2mSql::*;
import meta::pure::mapping::*;
import meta::external::store::model::*;
import meta::pure::graphFetch::*;

function <<test.Test>> meta::relational::m2mSql::tests::testSimpleRenameIsTranslatable():Boolean[1]
{
  let mapping = meta::relational::m2mSql::tests::simpleRename::TestMapping;
  let setImpl = $mapping->rootClassMappingByClass(meta::relational::m2mSql::tests::simpleRename::Person)->cast(@PureInstanceSetImplementation)->toOne();
  let tree    = #{meta::relational::m2mSql::tests::simpleRename::Person{fullName}}#->cast(@RootGraphFetchTree<Any>);

  let result = canPlanM2MSql($setImpl, $tree, $mapping);
  assert($result.translatable, | 'expected simple rename mapping to be translatable, got reason: ' + $result.reason->orElse(''));
}

function <<test.Test>> meta::relational::m2mSql::tests::testMappingFilterIsNotTranslatable():Boolean[1]
{
  let mapping = meta::relational::m2mSql::tests::mappingFilter::TestMapping;
  let setImpl = $mapping->rootClassMappingByClass(meta::relational::m2mSql::tests::mappingFilter::Person)->cast(@PureInstanceSetImplementation)->toOne();
  let tree    = #{meta::relational::m2mSql::tests::mappingFilter::Person{name}}#->cast(@RootGraphFetchTree<Any>);

  let result = canPlanM2MSql($setImpl, $tree, $mapping);
  assertFalse($result.translatable);
  assert($result.reason->isNotEmpty() && $result.reason->toOne()->toLower()->contains('filter'), | 'expected reason to mention filter, got: ' + $result.reason->orElse('<none>'));
}

function <<test.Test>> meta::relational::m2mSql::tests::testEnumTransformerIsNotTranslatable():Boolean[1]
{
  let mapping = meta::relational::m2mSql::tests::enumTransform::TestMapping;
