function <<test.Test>> meta::relational::m2mSql::tests::testAutoMappedIsTranslatable():Boolean[1]
{
  let mapping      = meta::relational::m2mSql::tests::autoMapped::TestMapping;
  let setImpl      = $mapping->rootClassMappingByClass(meta::relational::m2mSql::tests::autoMapped::Item)->cast(@PureInstanceSetImplementation)->toOne();
  let nameProperty = meta::relational::m2mSql::tests::autoMapped::Item->propertyByName('name')->toOne();

  // Ground the test in the store contract's own definition of auto-mapping (verified empirically,
  // not assumed): name has no PurePropertyMapping at all in TestMapping above (only other does),
  // and source/target both declare it with the same name/type, so the M2M store contract itself
  // reports it as auto-mapped. canPlanM2MSql must therefore treat it as translatable too.
  assert($nameProperty->meta::pure::mapping::modelToModel::contract::isPropertyAutoMapped($setImpl), | 'expected name to be reported as auto-mapped by the M2M store contract (it has no explicit property mapping in TestMapping and source/target agree on name/type)');

  let tree   = #{meta::relational::m2mSql::tests::autoMapped::Item{name, other}}#->cast(@RootGraphFetchTree<Any>);
  let result = canPlanM2MSql($setImpl, $tree, $mapping);
  assert($result.translatable, | 'expected a genuinely unmapped, store-contract-auto-mapped property to be translatable, got reason: ' + $result.reason->orElse(''));
}

