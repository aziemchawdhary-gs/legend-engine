// canPlanM2MSql used to recurse into a to-many complex property and report it translatable, at which
// point jsonProjection.pure's flat single-row projection would assert instead of falling back.
function <<test.Test>> meta::relational::m2mSql::tests::testToManyComplexPropertyIsNotTranslatable():Boolean[1]
{
  let mapping = meta::relational::m2mSql::tests::toManyComplex::TestMapping;
  let setImpl = $mapping->rootClassMappingByClass(meta::relational::m2mSql::tests::toManyComplex::Person)->cast(@PureInstanceSetImplementation)->toOne();
  let tree    = #{meta::relational::m2mSql::tests::toManyComplex::Person{addresses{city}}}#->cast(@RootGraphFetchTree<Any>);

  let result = canPlanM2MSql($setImpl, $tree, $mapping);
  assertFalse($result.translatable, | 'expected a to-many complex property to be rejected');
  assert($result.reason->toOne()->contains('to-many'), | 'expected a to-many reason, got: ' + $result.reason->orElse(''));
}

