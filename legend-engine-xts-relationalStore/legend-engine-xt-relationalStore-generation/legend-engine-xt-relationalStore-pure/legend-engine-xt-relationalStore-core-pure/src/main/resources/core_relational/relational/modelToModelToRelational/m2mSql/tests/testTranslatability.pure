function <<test.Test>> meta::relational::m2mSql::tests::testNonWhitelistedFunctionIsNotTranslatable():Boolean[1]
{
  let mapping = meta::relational::m2mSql::tests::unsupportedFunction::TestMapping;
  let setImpl = $mapping->rootClassMappingByClass(meta::relational::m2mSql::tests::unsupportedFunction::Person)->cast(@PureInstanceSetImplementation)->toOne();
  let tree    = #{meta::relational::m2mSql::tests::unsupportedFunction::Person{name}}#->cast(@RootGraphFetchTree<Any>);

  let result = canPlanM2MSql($setImpl, $tree, $mapping);
  assertFalse($result.translatable);
  assert($result.reason->isNotEmpty() && $result.reason->toOne()->toLower()->contains('trim'), | 'expected reason to name the trim function, got: ' + $result.reason->orElse('<none>'));
}

function <<test.Test>> meta::relational::m2mSql::tests::testSubTypeTreeIsNotTranslatable():Boolean[1]
{
  let mapping = meta::relational::m2mSql::tests::subTypeTree::TestMapping;
  let setImpl = $mapping->rootClassMappingByClass(meta::relational::m2mSql::tests::subTypeTree::Container)->cast(@PureInstanceSetImplementation)->toOne();
  let tree    = #{meta::relational::m2mSql::tests::subTypeTree::Container{name, shape->subType(@meta::relational::m2mSql::tests::subTypeTree::Circle){radius}}}#->cast(@RootGraphFetchTree<Any>);

  let result = canPlanM2MSql($setImpl, $tree, $mapping);
  assertFalse($result.translatable);
  assert($result.reason->isNotEmpty() && $result.reason->toOne()->contains('subType'), | 'expected reason to mention subType, got: ' + $result.reason->orElse('<none>'));
}

// Remaining translatable parity-corpus cases (Task 8's TestM2MSqlParity), included so the
// whitelist is checked against the full corpus this task's design context is bound to, not just
// the single positive case Step 1 of the brief calls out by name.

function <<test.Test>> meta::relational::m2mSql::tests::testComputedPrimitiveIsTranslatable():Boolean[1]
{
  let mapping = meta::relational::m2mSql::tests::computedPrimitive::TestMapping;
  let setImpl = $mapping->rootClassMappingByClass(meta::relational::m2mSql::tests::computedPrimitive::Result)->cast(@PureInstanceSetImplementation)->toOne();
  let tree    = #{meta::relational::m2mSql::tests::computedPrimitive::Result{product}}#->cast(@RootGraphFetchTree<Any>);

  let result = canPlanM2MSql($setImpl, $tree, $mapping);
  assert($result.translatable, | 'expected computed primitive (Integer * Integer) mapping to be translatable, got reason: ' + $result.reason->orElse(''));
}

