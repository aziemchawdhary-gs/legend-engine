###Mapping
Mapping meta::relational::m2mSql::tests::simpleRename::TestMapping
(
  *meta::relational::m2mSql::tests::simpleRename::Person: Pure
  {
    ~src meta::relational::m2mSql::tests::simpleRename::S_Person
    fullName: $src.firstName + ' ' + $src.lastName
  }
)

Mapping meta::relational::m2mSql::tests::mappingFilter::TestMapping
(
  *meta::relational::m2mSql::tests::mappingFilter::Person: Pure
  {
    ~src meta::relational::m2mSql::tests::mappingFilter::S_Person
    ~filter $src.active
    name: $src.name
  }
)

Mapping meta::relational::m2mSql::tests::enumTransform::TestMapping
(
  *meta::relational::m2mSql::tests::enumTransform::Item: Pure
  {
    ~src meta::relational::m2mSql::tests::enumTransform::S_Item
    color: EnumerationMapping colorMapping : $src.color
  }
  meta::relational::m2mSql::tests::enumTransform::TargetColor: EnumerationMapping colorMapping
  {
    RED: [meta::relational::m2mSql::tests::enumTransform::SourceColor.ROUGE],
    GREEN: [meta::relational::m2mSql::tests::enumTransform::SourceColor.VERT],
    BLUE: [meta::relational::m2mSql::tests::enumTransform::SourceColor.BLEU]
  }
)

Mapping meta::relational::m2mSql::tests::explodeMapping::TestMapping
(
  *meta::relational::m2mSql::tests::explodeMapping::Tag: Pure
  {
    ~src meta::relational::m2mSql::tests::explodeMapping::S_Item
    name* : $src.tags
  }
)

Mapping meta::relational::m2mSql::tests::localProperty::TestMapping
(
  *meta::relational::m2mSql::tests::localProperty::Person: Pure
  {
    ~src meta::relational::m2mSql::tests::localProperty::S_Person
    fullName: $src.firstName,
