// $src.address->toOne() passes explainUntranslatableExpression (toOne is whitelisted) and is not
// to-many, so every other check admits it -- but it is not a plain navigation, so the SQL projection
// has no JSON path for the subtree's presence check.
Class meta::relational::m2mSql::tests::toOneComplex::Address
{
  city: String[1];
}
Class meta::relational::m2mSql::tests::toOneComplex::Person
{
  address: meta::relational::m2mSql::tests::toOneComplex::Address[1];
}
Class meta::relational::m2mSql::tests::toOneComplex::S_Address
{
  city: String[1];
}
Class meta::relational::m2mSql::tests::toOneComplex::S_Person
{
  address: meta::relational::m2mSql::tests::toOneComplex::S_Address[0..1];
}

// A complex property mapped to the bare source object: the nested target is built from the source
// document root itself. It is a plain source navigation, but its JSON path has no segments, so the
// subtree's presence column would read an empty path.
Class meta::relational::m2mSql::tests::selfSource::Inner
{
  value: String[1];
}
Class meta::relational::m2mSql::tests::selfSource::Wrapper
{
  inner: meta::relational::m2mSql::tests::selfSource::Inner[1];
}
Class meta::relational::m2mSql::tests::selfSource::S_Flat
{
  value: String[1];
}

// An Enumeration-typed source property passed straight through, with no EnumerationMapping in
// sight: the synthetic source store extracts it as VARCHAR, the enum's name.
Enum meta::relational::m2mSql::tests::enumProperty::Colour
{
  RED, GREEN
}
Class meta::relational::m2mSql::tests::enumProperty::Item
{
  colour: meta::relational::m2mSql::tests::enumProperty::Colour[1];
  other: String[1];
}
Class meta::relational::m2mSql::tests::enumProperty::S_Item
{
  colour: meta::relational::m2mSql::tests::enumProperty::Colour[1];
  other: String[1];
}

// The same on the auto-mapping branch: colour is left entirely unmapped below.
Class meta::relational::m2mSql::tests::enumAutoMapped::Item
{
  colour: meta::relational::m2mSql::tests::enumProperty::Colour[1];
  other: String[1];
}
Class meta::relational::m2mSql::tests::enumAutoMapped::S_Item
{
  colour: meta::relational::m2mSql::tests::enumProperty::Colour[1];
  other: String[1];
}

// address is left entirely unmapped below (no PurePropertyMapping at all), matching name/type with
// the source so the M2M store contract auto-maps it. Its nested class's own mapping has an
// untranslatable transform on city, which the no-property-mapping branch of
// untranslatablePropertyReasons must catch by recursing, rather than accepting the property outright
// and letting flattenTargetTree/nestedSetImplementation hit it downstream.
Class meta::relational::m2mSql::tests::autoMappedComplex::Address
{
  city: String[1];
}
Class meta::relational::m2mSql::tests::autoMappedComplex::Person
{
  name: String[1];
  address: meta::relational::m2mSql::tests::autoMappedComplex::Address[0..1];
}
Class meta::relational::m2mSql::tests::autoMappedComplex::S_Address
{
  city: String[1];
}
Class meta::relational::m2mSql::tests::autoMappedComplex::S_Person
{
  name: String[1];
  address: meta::relational::m2mSql::tests::autoMappedComplex::S_Address[0..1];
}

// The differential half of the pin above: same shape, but the nested class's mapping is fully
// translatable, so the auto-mapped complex property must now be accepted (recursed into), not
// rejected outright the way it was before this property could resolve at all.
Class meta::relational::m2mSql::tests::autoMappedComplexTranslatable::Address
{
  city: String[1];
}
Class meta::relational::m2mSql::tests::autoMappedComplexTranslatable::Person
{
  name: String[1];
  address: meta::relational::m2mSql::tests::autoMappedComplexTranslatable::Address[0..1];
}
Class meta::relational::m2mSql::tests::autoMappedComplexTranslatable::S_Address
{
  city: String[1];
}
Class meta::relational::m2mSql::tests::autoMappedComplexTranslatable::S_Person
{
  name: String[1];
  address: meta::relational::m2mSql::tests::autoMappedComplexTranslatable::S_Address[0..1];
}

###Mapping
Mapping meta::relational::m2mSql::tests::simpleRename::TestMapping
(
  *meta::relational::m2mSql::tests::simpleRename::Person: Pure
  {
    ~src meta::relational::m2mSql::tests::simpleRename::S_Person
    fullName: $src.firstName + ' ' + $src.lastName
  }
)

Mapping meta::relational::m2mSql::tests::mappingFilter::TestMapping
(
  *meta::relational::m2mSql::tests::mappingFilter::Person: Pure
  {
    ~src meta::relational::m2mSql::tests::mappingFilter::S_Person
    ~filter $src.active
    name: $src.name
  }
)

Mapping meta::relational::m2mSql::tests::comparisonFilter::TestMapping
(
  *meta::relational::m2mSql::tests::comparisonFilter::Person: Pure
  {
    ~src meta::relational::m2mSql::tests::comparisonFilter::S_Person
    ~filter (($src.age > 0) || ($src.age < 0)) && ($src.age <= 200) && ($src.age >= 18) && !($src.name == 'Zed')
    name: $src.name
  }
)

Mapping meta::relational::m2mSql::tests::untranslatableFilter::TestMapping
(
  *meta::relational::m2mSql::tests::comparisonFilter::Person: Pure
  {
    ~src meta::relational::m2mSql::tests::comparisonFilter::S_Person
    ~filter $src.name->trim() == 'Zed'
    name: $src.name
  }
)

Mapping meta::relational::m2mSql::tests::nestedFilter::TestMapping
(
  *meta::relational::m2mSql::tests::nestedFilter::Person: Pure
  {
    ~src meta::relational::m2mSql::tests::nestedFilter::S_Person
    name: $src.name,
    address: $src.address
  }
  *meta::relational::m2mSql::tests::nestedFilter::Address: Pure
  {
    ~src meta::relational::m2mSql::tests::nestedFilter::S_Address
    ~filter $src.city == 'NYC'
    city: $src.city
  }
)

Mapping meta::relational::m2mSql::tests::enumTransform::TestMapping
(
  *meta::relational::m2mSql::tests::enumTransform::Item: Pure
  {
    ~src meta::relational::m2mSql::tests::enumTransform::S_Item
    color: EnumerationMapping colorMapping : $src.color
  }
  meta::relational::m2mSql::tests::enumTransform::TargetColor: EnumerationMapping colorMapping
  {
    RED: [meta::relational::m2mSql::tests::enumTransform::SourceColor.ROUGE],
    GREEN: [meta::relational::m2mSql::tests::enumTransform::SourceColor.VERT],
    BLUE: [meta::relational::m2mSql::tests::enumTransform::SourceColor.BLEU]
  }
)

