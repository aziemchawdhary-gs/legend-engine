// name is deliberately left OUT of the mapping below so it is genuinely unmapped (not just an
// explicit same-name passthrough like simpleRename/computedPrimitive): source and target both
// declare it with the same name/type, so it is a candidate for
// meta::pure::mapping::modelToModel::contract::isPropertyAutoMapped. other is mapped explicitly
// so the class mapping body is non-empty (an entirely property-mapping-free class mapping body
// does not parse).
Class meta::relational::m2mSql::tests::autoMapped::Item
{
  name: String[1];
  other: String[1];
}
Class meta::relational::m2mSql::tests::autoMapped::S_Item
{
  name: String[1];
  other: String[1];
}

