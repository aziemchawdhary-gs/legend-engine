// Below the root the leaf reaches the outer query as JSON, not as the scalar the CASE compares against.
function <<test.Test>> meta::relational::m2mSql::tests::testNestedEnumTransformerIsNotTranslatable():Boolean[1]
{
  let mapping = meta::relational::m2mSql::tests::nestedEnumTransform::TestMapping;
  let setImpl = $mapping->rootClassMappingByClass(meta::relational::m2mSql::tests::nestedEnumTransform::Holder)->cast(@PureInstanceSetImplementation)->toOne();
  let tree    = #{meta::relational::m2mSql::tests::nestedEnumTransform::Holder{item{color}}}#->cast(@RootGraphFetchTree<Any>);

  let result = canPlanM2MSql($setImpl, $tree, $mapping);
  assertFalse($result.translatable);
  assertEquals('enumeration transformer not yet translated', $result.reason->orElse('<none>'));
}

function meta::relational::m2mSql::tests::explodeVerdict(mapping:Mapping[1], targetClass:Class<Any>[1], tree:RootGraphFetchTree<Any>[1]):meta::relational::m2mSql::M2MSqlTranslatability[1]
{
  canPlanM2MSql($mapping->rootClassMappingByClass($targetClass)->cast(@PureInstanceSetImplementation)->toOne(), $tree, $mapping);
}

function <<test.Test>> meta::relational::m2mSql::tests::testExplodeOfComputedCollectionIsNotTranslatable():Boolean[1]
{
  let result = meta::relational::m2mSql::tests::explodeVerdict(meta::relational::m2mSql::tests::explodeComputed::TestMapping, meta::relational::m2mSql::tests::explodeMapping::Tag,
                 #{meta::relational::m2mSql::tests::explodeMapping::Tag{name}}#->cast(@RootGraphFetchTree<Any>));
  assertEquals('explode property mapping is not a single source navigation to a String or Integer collection', $result.reason->orElse('<none>'));
}

function <<test.Test>> meta::relational::m2mSql::tests::testTwoExplodeMappingsAreNotTranslatable():Boolean[1]
{
  let result = meta::relational::m2mSql::tests::explodeVerdict(meta::relational::m2mSql::tests::explodeTwice::TestMapping, meta::relational::m2mSql::tests::explodeMapping::LabelledTag,
                 #{meta::relational::m2mSql::tests::explodeMapping::LabelledTag{name, label}}#->cast(@RootGraphFetchTree<Any>));
  assertEquals('more than one explode property mapping not yet translated', $result.reason->orElse('<none>'));
}

// The Java path multiplies the instances whether or not the exploded property is fetched; the
// projection only knows to when the tree selects it.
function <<test.Test>> meta::relational::m2mSql::tests::testUnselectedExplodeMappingIsNotTranslatable():Boolean[1]
{
  let result = meta::relational::m2mSql::tests::explodeVerdict(meta::relational::m2mSql::tests::explodeUnselected::TestMapping, meta::relational::m2mSql::tests::explodeMapping::LabelledTag,
                 #{meta::relational::m2mSql::tests::explodeMapping::LabelledTag{label}}#->cast(@RootGraphFetchTree<Any>));
  assertEquals('explode property mapping is not selected as a leaf of the graph fetch tree', $result.reason->orElse('<none>'));
}

function <<test.Test>> meta::relational::m2mSql::tests::testNonStringPrimitiveCollectionIsNotTranslatable():Boolean[1]
{
  let result = meta::relational::m2mSql::tests::explodeVerdict(meta::relational::m2mSql::tests::integerCollection::TestMapping, meta::relational::m2mSql::tests::integerCollection::Item,
                 #{meta::relational::m2mSql::tests::integerCollection::Item{codes}}#->cast(@RootGraphFetchTree<Any>));
  assertEquals('non-string primitive collection not yet translated: codes', $result.reason->orElse('<none>'));
}

function meta::relational::m2mSql::tests::reviewReason(mapping:Mapping[1], tree:RootGraphFetchTree<Any>[1]):String[1]
{
  meta::relational::m2mSql::tests::explodeVerdict($mapping, $tree.class, $tree).reason->orElse('<translatable>');
}

// `plus` holds its operands as the values of one InstanceValue; a function call among them has to be
// seen by the whitelist like any other.
function <<test.Test>> meta::relational::m2mSql::tests::testFunctionHiddenInPlusOperandIsNotTranslatable():Boolean[1]
{
  assertEquals('unsupported transform for property text: unsupported function in transform: trim',
               meta::relational::m2mSql::tests::reviewReason(meta::relational::m2mSql::tests::review::HiddenFunctionMapping, #{meta::relational::m2mSql::tests::review::Target{text}}#->cast(@RootGraphFetchTree<Any>)));
}

// The target property access sits inside `plus`'s operand collection and has to be rewritten there too.
function <<test.Test>> meta::relational::m2mSql::tests::testRootFilterInsidePlusOperandIsRewrittenToSource():Boolean[1]
{
  let rewritten = meta::relational::m2mSql::tests::rewriteRootFilter(
                    {t:meta::relational::m2mSql::tests::review::Target[1] | ($t.text + '!') == 'Jane Doe!'},
                    meta::relational::m2mSql::tests::review::ConcatMapping,
                    meta::relational::m2mSql::tests::review::Target);
  assertEquals(['$src', 'first', '$src', 'last'], $rewritten->toOne()->meta::relational::m2mSql::tests::propertiesAndVariables());
}

// pureToSQLQuery asserts on an equality with a to-many side, so it must not get that far.
function <<test.Test>> meta::relational::m2mSql::tests::testEqualityOverCollectionIsNotTranslatable():Boolean[1]
{
  assertEquals('unsupported mapping filter: equality over a collection is not translated',
               meta::relational::m2mSql::tests::reviewReason(meta::relational::m2mSql::tests::review::CollectionEqualityMapping, #{meta::relational::m2mSql::tests::review::Target{text}}#->cast(@RootGraphFetchTree<Any>)));
}

function <<test.Test>> meta::relational::m2mSql::tests::testRootFilterOnCollectionPropertyIsNotRewritten():Boolean[1]
{
  let rewritten = meta::relational::m2mSql::tests::rewriteRootFilter(
                    {t:meta::relational::m2mSql::tests::review::Target[1] | $t.tags == 'a'},
                    meta::relational::m2mSql::tests::review::ConcatMapping,
                    meta::relational::m2mSql::tests::review::Target);
  assertEmpty($rewritten);
}

// FLOAT[] is 32-bit in DuckDB; a Float leaf is rejected for its type before the explode shape is looked at.
function <<test.Test>> meta::relational::m2mSql::tests::testExplodeOfFloatCollectionIsNotTranslatable():Boolean[1]
{
  assertEquals('property type not yet translated: amount',
               meta::relational::m2mSql::tests::reviewReason(meta::relational::m2mSql::tests::review::ExplodeFloatMapping, #{meta::relational::m2mSql::tests::review::Target{amount}}#->cast(@RootGraphFetchTree<Any>)));
}

function <<test.Test>> meta::relational::m2mSql::tests::testExplodeOfScalarIsNotTranslatable():Boolean[1]
{
  assertEquals('explode property mapping is not a single source navigation to a String or Integer collection',
               meta::relational::m2mSql::tests::reviewReason(meta::relational::m2mSql::tests::review::ExplodeScalarMapping, #{meta::relational::m2mSql::tests::review::Target{text}}#->cast(@RootGraphFetchTree<Any>)));
}

// The Java path looks the transform's value up by its own type: a String never matches an enumeration
// source value. Comparing by name in SQL would match where the Java path fails.
function <<test.Test>> meta::relational::m2mSql::tests::testEnumTransformerOverMismatchedTransformTypeIsNotTranslatable():Boolean[1]
{
  assertEquals('enumeration transformer source values do not match the type of the transform',
               meta::relational::m2mSql::tests::reviewReason(meta::relational::m2mSql::tests::review::EnumOverStringMapping, #{meta::relational::m2mSql::tests::review::Target{color}}#->cast(@RootGraphFetchTree<Any>)));
}

// Below the root a leaf is read as JSON, which only a plain navigation leaves intact.
function <<test.Test>> meta::relational::m2mSql::tests::testComputedPropertyOnNestedSetIsNotTranslatable():Boolean[1]
{
  assertEquals('computed property label on a nested class mapping not yet translated',
               meta::relational::m2mSql::tests::reviewReason(meta::relational::m2mSql::tests::review::NestedComputedMapping, #{meta::relational::m2mSql::tests::review::Outer{inner{label}}}#->cast(@RootGraphFetchTree<Any>)));
}

// Float, Decimal and the date types have no parity case yet: how DuckDB extracts and serializes them
// (32-bit floats, DECIMAL(18,3), its own timestamp text) is not established to match the Java path.
function <<test.Test>> meta::relational::m2mSql::tests::testUnprovenScalarTypesAreNotTranslatable():Boolean[1]
{
  let mapping = meta::relational::m2mSql::tests::scalarTypes::TestMapping;
  assertEquals('property type not yet translated: f',  meta::relational::m2mSql::tests::reviewReason($mapping, #{meta::relational::m2mSql::tests::scalarTypes::Item{f}}#->cast(@RootGraphFetchTree<Any>)));
  assertEquals('property type not yet translated: d',  meta::relational::m2mSql::tests::reviewReason($mapping, #{meta::relational::m2mSql::tests::scalarTypes::Item{d}}#->cast(@RootGraphFetchTree<Any>)));
  assertEquals('property type not yet translated: sd', meta::relational::m2mSql::tests::reviewReason($mapping, #{meta::relational::m2mSql::tests::scalarTypes::Item{sd}}#->cast(@RootGraphFetchTree<Any>)));
  assertEquals('property type not yet translated: dt', meta::relational::m2mSql::tests::reviewReason($mapping, #{meta::relational::m2mSql::tests::scalarTypes::Item{dt}}#->cast(@RootGraphFetchTree<Any>)));
  assertEquals('<translatable>',                      meta::relational::m2mSql::tests::reviewReason($mapping, #{meta::relational::m2mSql::tests::scalarTypes::Item{s}}#->cast(@RootGraphFetchTree<Any>)));
}
