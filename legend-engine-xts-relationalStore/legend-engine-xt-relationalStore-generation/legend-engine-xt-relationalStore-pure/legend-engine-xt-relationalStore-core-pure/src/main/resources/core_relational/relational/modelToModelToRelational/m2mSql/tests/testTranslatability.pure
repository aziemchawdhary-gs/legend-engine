function <<test.Test>> meta::relational::m2mSql::tests::testAutoMappedEnumerationPropertyIsNotTranslatable():Boolean[1]
{
  let mapping        = meta::relational::m2mSql::tests::enumAutoMapped::TestMapping;
  let setImpl        = $mapping->rootClassMappingByClass(meta::relational::m2mSql::tests::enumAutoMapped::Item)->cast(@PureInstanceSetImplementation)->toOne();
  let colourProperty = meta::relational::m2mSql::tests::enumAutoMapped::Item->propertyByName('colour')->toOne();

  // Pin the precondition the same way testAutoMappedIsTranslatable does: without the store contract
  // reporting colour as auto-mapped, this test would be exercising the "does not resolve" branch and
  // would pass for the wrong reason.
  assert($colourProperty->meta::pure::mapping::modelToModel::contract::isPropertyAutoMapped($setImpl), | 'expected colour to be reported as auto-mapped by the M2M store contract');

  let tree   = #{meta::relational::m2mSql::tests::enumAutoMapped::Item{colour, other}}#->cast(@RootGraphFetchTree<Any>);
  let result = canPlanM2MSql($setImpl, $tree, $mapping);
  assertFalse($result.translatable, | 'expected an auto-mapped enumeration property to be rejected');
  assert($result.reason->toOne()->contains('enumeration'), | 'expected an enumeration reason, got: ' + $result.reason->orElse(''));
}

function <<test.Test>> meta::relational::m2mSql::tests::testNonNavigationComplexPropertyIsNotTranslatable():Boolean[1]
{
  let mapping = meta::relational::m2mSql::tests::toOneComplex::TestMapping;
  let setImpl = $mapping->rootClassMappingByClass(meta::relational::m2mSql::tests::toOneComplex::Person)->cast(@PureInstanceSetImplementation)->toOne();
  let tree    = #{meta::relational::m2mSql::tests::toOneComplex::Person{address{city}}}#->cast(@RootGraphFetchTree<Any>);

  // Pin the precondition, so this cannot start passing for an unrelated reason: every *other* check
  // in the gate accepts this transform.
  let transform = $setImpl->propertyMappingsByPropertyName('address')->at(0)->cast(@PurePropertyMapping).transform.expressionSequence->toOne();
  assert($transform->meta::relational::m2mSql::explainUntranslatableExpression()->isEmpty(), | 'expected ->toOne() to be accepted by the expression whitelist');

  let result = canPlanM2MSql($setImpl, $tree, $mapping);
  assertFalse($result.translatable, | 'expected a non-navigation complex property transform to be rejected');
  assert($result.reason->toOne()->contains('plain source navigation'), | 'expected a plain-source-navigation reason, got: ' + $result.reason->orElse(''));
}

// The complement of the case above: a bare `$src` clears both the expression whitelist and the
// plain-navigation check, but jsonProjection.pure's sourceJsonPath would hand the presence column an
// empty JSON path, so the gate has to reject it in its own right.
function <<test.Test>> meta::relational::m2mSql::tests::testBareSourceComplexPropertyIsNotTranslatable():Boolean[1]
{
  let mapping = meta::relational::m2mSql::tests::selfSource::TestMapping;
  let setImpl = $mapping->rootClassMappingByClass(meta::relational::m2mSql::tests::selfSource::Wrapper)->cast(@PureInstanceSetImplementation)->toOne();

  // Pin the preconditions, so this cannot start passing for an unrelated reason.
  let transform = $setImpl->propertyMappingsByPropertyName('inner')->at(0)->cast(@PurePropertyMapping).transform.expressionSequence->toOne();
  assert($transform->meta::relational::m2mSql::explainUntranslatableExpression()->isEmpty(), | 'expected a bare $src to be accepted by the expression whitelist');
  assert($transform->meta::relational::m2mSql::isPlainSourceNavigation(), | 'expected a bare $src to be accepted as a plain source navigation');

  let tree   = #{meta::relational::m2mSql::tests::selfSource::Wrapper{inner{value}}}#->cast(@RootGraphFetchTree<Any>);
  let result = canPlanM2MSql($setImpl, $tree, $mapping);
  assertFalse($result.translatable, | 'expected a complex property mapped to the bare source object to be rejected');
  assert($result.reason->toOne()->contains('source property access'), | 'expected a source-property-access reason, got: ' + $result.reason->orElse(''));
}

// An auto-mapped complex property (no PurePropertyMapping at all) with an untranslatable child must
// still fall back with a reason, not slip past the gate and crash downstream in
// flattenTargetTree/nestedSetImplementation.
function <<test.Test>> meta::relational::m2mSql::tests::testAutoMappedComplexPropertyRecursesIntoChild():Boolean[1]
{
  let mapping = meta::relational::m2mSql::tests::autoMappedComplex::TestMapping;
  let setImpl = $mapping->rootClassMappingByClass(meta::relational::m2mSql::tests::autoMappedComplex::Person)->cast(@PureInstanceSetImplementation)->toOne();

  // Pin the precondition: address has no PurePropertyMapping in TestMapping above.
  assert($setImpl->propertyMappingsByPropertyName('address')->filter(pm | $pm->instanceOf(PurePropertyMapping))->isEmpty(), | 'expected address to have no PurePropertyMapping in TestMapping');

  let tree   = #{meta::relational::m2mSql::tests::autoMappedComplex::Person{name, address{city}}}#->cast(@RootGraphFetchTree<Any>);
  let result = canPlanM2MSql($setImpl, $tree, $mapping);
  assertFalse($result.translatable, | 'expected an auto-mapped complex property with an untranslatable child to be rejected');
  assert($result.reason->isNotEmpty() && $result.reason->toOne()->toLower()->contains('trim'), | 'expected the reason to name the untranslatable child transform, got: ' + $result.reason->orElse('<none>'));
}

function <<test.Test>> meta::relational::m2mSql::tests::testAutoMappedComplexPropertyIsTranslatableWhenChildIs():Boolean[1]
{
  let mapping = meta::relational::m2mSql::tests::autoMappedComplexTranslatable::TestMapping;
  let setImpl = $mapping->rootClassMappingByClass(meta::relational::m2mSql::tests::autoMappedComplexTranslatable::Person)->cast(@PureInstanceSetImplementation)->toOne();

  assert($setImpl->propertyMappingsByPropertyName('address')->filter(pm | $pm->instanceOf(PurePropertyMapping))->isEmpty(), | 'expected address to have no PurePropertyMapping in TestMapping');

  let tree   = #{meta::relational::m2mSql::tests::autoMappedComplexTranslatable::Person{name, address{city}}}#->cast(@RootGraphFetchTree<Any>);
  let result = canPlanM2MSql($setImpl, $tree, $mapping);
  assert($result.translatable, | 'expected an auto-mapped complex property whose child is translatable to be accepted, got reason: ' + $result.reason->orElse(''));
}
