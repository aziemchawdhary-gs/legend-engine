{
  city : String[1];
}

Class meta::relational::tests::sqlQueryToString::duckDB::m2mSqlCollapse::model::S_Employee
{
  name    : String[1];
  address : meta::relational::tests::sqlQueryToString::duckDB::m2mSqlCollapse::model::S_Address[0..1];
}

Class meta::relational::tests::sqlQueryToString::duckDB::m2mSqlCollapse::model::Address
{
  city : String[1];
}

Class meta::relational::tests::sqlQueryToString::duckDB::m2mSqlCollapse::model::Employee
{
  name    : String[1];
  address : meta::relational::tests::sqlQueryToString::duckDB::m2mSqlCollapse::model::Address[0..1];
}

Class meta::relational::tests::sqlQueryToString::duckDB::m2mSqlCollapse::model::S_Constrained
{
  name : String[1];
}

Class meta::relational::tests::sqlQueryToString::duckDB::m2mSqlCollapse::model::S_Coerced
{
  address : meta::relational::tests::sqlQueryToString::duckDB::m2mSqlCollapse::model::S_Address[0..1];
}

// address is mapped with `$src.address->toOne()`: whitelisted, to-one, and otherwise translatable,
// but not a plain navigation, so the projection has no JSON path for its presence check. The gate
// must decline rather than let plan generation blow up.
Class meta::relational::tests::sqlQueryToString::duckDB::m2mSqlCollapse::model::Coerced
{
  address : meta::relational::tests::sqlQueryToString::duckDB::m2mSqlCollapse::model::Address[1];
}

// The Java graph fetch path enforces this constraint on every fetched object; the SQL projection has
// no equivalent, so the collapse must decline rather than silently drop the check.
Class meta::relational::tests::sqlQueryToString::duckDB::m2mSqlCollapse::model::Constrained
[
  nonEmptyName: $this.name->length() > 0
]
{
  name : String[1];
}

// The same hole on the source side: the Java path deserializes the source document into real
// S_ConstrainedSource instances and checks this constraint while reading the stream. Nothing about
// the *target* class gives that away, so the collapse needs its own source-side guard.
Class meta::relational::tests::sqlQueryToString::duckDB::m2mSqlCollapse::model::S_ConstrainedSource
[
  nonEmptyName: $this.name->length() > 0
]
{
  name : String[1];
}

// Identical to S_ConstrainedSource but for the constraint, so the pair isolates the source-side
// guard: same target class, same mapping body, same target tree.
Class meta::relational::tests::sqlQueryToString::duckDB::m2mSqlCollapse::model::S_PlainSource
{
  name : String[1];
}

Class meta::relational::tests::sqlQueryToString::duckDB::m2mSqlCollapse::model::PlainTarget
{
  name : String[1];
}

###Mapping
Mapping meta::relational::tests::sqlQueryToString::duckDB::m2mSqlCollapse::collapseMapping
(
  *meta::relational::tests::sqlQueryToString::duckDB::m2mSqlCollapse::model::Person: Pure
  {
    ~src meta::relational::tests::sqlQueryToString::duckDB::m2mSqlCollapse::model::S_Person
    fullName: $src.firstName + ' ' + $src.lastName
  }
)

