###Mapping
Mapping meta::relational::tests::sqlQueryToString::duckDB::m2mSqlProjection::simpleRenameMapping
(
  *meta::relational::tests::sqlQueryToString::duckDB::m2mSqlProjection::model::Person: Pure
  {
    ~src meta::relational::tests::sqlQueryToString::duckDB::m2mSqlProjection::model::S_Person
    fullName: $src.firstName + ' ' + $src.lastName
  }
)

Mapping meta::relational::tests::sqlQueryToString::duckDB::m2mSqlProjection::nestedComplexToOneMapping
(
  *meta::relational::tests::sqlQueryToString::duckDB::m2mSqlProjection::model::Employee: Pure
  {
    ~src meta::relational::tests::sqlQueryToString::duckDB::m2mSqlProjection::model::S_Employee
    fullName: $src.firstName + ' ' + $src.lastName,
    nickname: $src.nickname,
    address: $src.address
  }
  *meta::relational::tests::sqlQueryToString::duckDB::m2mSqlProjection::model::Address: Pure
  {
    ~src meta::relational::tests::sqlQueryToString::duckDB::m2mSqlProjection::model::S_Address
    street: $src.street
  }
)

Mapping meta::relational::tests::sqlQueryToString::duckDB::m2mSqlProjection::primitiveCollectionMapping
(
  *meta::relational::tests::sqlQueryToString::duckDB::m2mSqlProjection::model::Item: Pure
  {
    ~src meta::relational::tests::sqlQueryToString::duckDB::m2mSqlProjection::model::S_Item
    tags: $src.tags
