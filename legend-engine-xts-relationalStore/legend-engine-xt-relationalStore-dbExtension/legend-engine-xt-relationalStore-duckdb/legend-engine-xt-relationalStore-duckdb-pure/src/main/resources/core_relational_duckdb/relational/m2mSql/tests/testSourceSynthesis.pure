###Pure
import meta::core::runtime::*;
import meta::external::store::relational::runtime::*;
import meta::relational::extension::*;
import meta::relational::functions::sqlstring::*;
import meta::relational::m2mSql::*;
import meta::relational::runtime::*;
import meta::relational::tests::sqlQueryToString::duckDB::m2mSql::model::*;

Class meta::relational::tests::sqlQueryToString::duckDB::m2mSql::model::SrcAddress
{
  street : String[1];
}

Class meta::relational::tests::sqlQueryToString::duckDB::m2mSql::model::SrcPerson
{
  firstName : String[1];
  age       : Integer[1];
  address   : SrcAddress[0..1];
}

Enum meta::relational::tests::sqlQueryToString::duckDB::m2mSql::model::SrcColour
{
  RED, GREEN
}

Class meta::relational::tests::sqlQueryToString::duckDB::m2mSql::model::SrcItem
{
  colour : meta::relational::tests::sqlQueryToString::duckDB::m2mSql::model::SrcColour[1];
}

function <<test.Test>> meta::relational::tests::sqlQueryToString::duckDB::m2mSql::testSimpleSourceSynthesisSql():Boolean[1]
{
  let src = synthesizeSourceStore(SrcPerson, #{SrcPerson {firstName, age}}#);
  let sql = toSQLString(
              |SrcPerson.all()->project([s | $s.firstName, s | $s.age], ['firstName', 'age']),
              $src.mapping,
              DatabaseType.DuckDB,
              relationalExtensions()
            );
  assertEquals('select json_extract_string("root".data, \'$.firstName\') as "firstName", cast(json_extract("root".data, \'$.age\') as BIGINT) as "age" from m2m_src_0 as "root"', $sql);
}

function <<test.Test>> meta::relational::tests::sqlQueryToString::duckDB::m2mSql::testNestedSourceSynthesisSql():Boolean[1]
{
  let src = synthesizeSourceStore(SrcPerson, #{SrcPerson {firstName, address {street}}}#);
  let sql = toSQLString(
              |SrcPerson.all()->project([s | $s.address.street], ['street']),
              $src.mapping,
              DatabaseType.DuckDB,
              relationalExtensions()
            );
  assertEquals('select "root".data->\'address\'->\'street\' as "street" from m2m_src_0 as "root"', $sql);
}

// The exact path buildM2MSqlQuery consumes: the synthetic Database is never registered as a packageable
// element, so it has to resolve through a real ConnectionStore during plan-node assembly, not just
// through the SQL generator that toSQLString exercises.
function <<test.Test>> meta::relational::tests::sqlQueryToString::duckDB::m2mSql::testSourceSynthesisExecutionPlan():Boolean[1]
{
  let src = synthesizeSourceStore(SrcPerson, #{SrcPerson {firstName, age}}#);
  let plan = meta::pure::executionPlan::executionPlan(
               |SrcPerson.all()->project([s | $s.firstName, s | $s.age], ['firstName', 'age']),
               $src.mapping,
               ^Runtime(connectionStores = ^ConnectionStore(
                   element = $src.database,
                   connection = ^RelationalDatabaseConnection(
                                  type = DatabaseType.DuckDB,
                                  datasourceSpecification = ^meta::pure::alloy::connections::alloy::specification::DuckDBDatasourceSpecification(path = ''),
                                  authenticationStrategy = ^meta::pure::alloy::connections::alloy::authentication::TestDatabaseAuthenticationStrategy()))),
               relationalExtensions()
             );
  let result = $plan->meta::pure::executionPlan::toString::planToString(relationalExtensions());
  assert($result->contains('m2m_src_0'), | 'expected the synthetic table in the plan, got: ' + $result);
  assert($result->contains('json_extract_string("root".data, \'$.firstName\')'), | 'expected semi-structured navigation, got: ' + $result);
}

// An enumeration value is its name in the source JSON, so it is read the way a String is.
function <<test.Test>> meta::relational::tests::sqlQueryToString::duckDB::m2mSql::testEnumerationSourceSynthesisSql():Boolean[1]
{
  let src = synthesizeSourceStore(SrcItem, #{SrcItem {colour}}#);
  let sql = toSQLString(
              |SrcItem.all()->project([s | $s.colour], ['colour']),
              $src.mapping,
              DatabaseType.DuckDB,
              relationalExtensions()
            );
  assertEquals('select json_extract_string("root".data, \'$.colour\') as "colour" from m2m_src_0 as "root"', $sql);
}
