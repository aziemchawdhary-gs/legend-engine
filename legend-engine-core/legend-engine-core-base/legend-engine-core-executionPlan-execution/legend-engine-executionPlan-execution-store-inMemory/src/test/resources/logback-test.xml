<!-- Mirrors the previous log4j.properties: keep test output silent by default. The
     InMemoryExecutionNodeExecutor logger is raised to INFO so TestM2MSqlFallbackLogging can
     assert on the M2M SQL fallback event via a directly-attached ListAppender; no appender is
     wired here, so this does not print to the console. -->
<configuration>
    <root level="OFF"/>
    <logger name="org.finos.legend.engine.plan.execution.stores.inMemory.plugin.InMemoryExecutionNodeExecutor" level="INFO"/>
</configuration>
